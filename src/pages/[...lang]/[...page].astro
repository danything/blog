---
import Pagination from "@components/control/Pagination.astro";
import PostPage from "@components/PostPage.astro";
import { PAGE_SIZE } from "@constants/constants";
import { type Lang, langPaths } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts, type PostEntry } from "@utils/content-utils";
import { localeUrl } from "@utils/url-utils";
import type { GetStaticPaths, Page } from "astro";
import { profileConfig, siteConfig, siteText } from "@/config";

// 記事一覧のページ(/、/2/ … と /en/、/en/2/ …)
export const getStaticPaths = (async ({ paginate }) =>
	(
		await Promise.all(
			langPaths().map(async ({ params, props }) =>
				paginate(await getSortedPosts(props.lang), {
					pageSize: PAGE_SIZE,
					params,
					props,
				}),
			),
		)
	).flat()) satisfies GetStaticPaths;

const { page, lang } = Astro.props as { page: Page<PostEntry>; lang: Lang };
const text = siteText[lang];

const len = page.data.length;

// トップページ(1 ページ目)だけに、サイトと著者の構造化データを出す
const person = {
	"@type": "Person",
	name: text.profileName,
	url: Astro.site,
	image: new URL(profileConfig.avatar, Astro.site).href,
	sameAs: profileConfig.links.map((link) => link.url),
};
const jsonLd =
	page.currentPage === 1
		? {
				"@context": "https://schema.org",
				"@type": "WebSite",
				name: siteConfig.title,
				url: new URL(localeUrl("/", lang), Astro.site).href,
				description: text.description,
				inLanguage: lang,
				author: person,
				publisher: person,
			}
		: undefined;
---

<MainGridLayout>
    {jsonLd && <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
    <PostPage page={page}></PostPage>
    <Pagination class="pagination onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>

<style>
    .pagination {
        margin-inline: auto;
    }
</style>
