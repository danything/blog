---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n, type Lang, langPaths } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";

// プロフィールのページ(/about/ と /en/about/)。本文は src/content/spec/about.md(英語版は about-en.md)
export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };

const aboutPost = await getEntry("spec", lang === "en" ? "about-en" : "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---
<MainGridLayout title={i18n(I18nKey.about, lang)} description={i18n(I18nKey.about, lang)}>
    <div class="page">
        <div class="card-base page-card">
            <Markdown class="content">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>

<style>
    .page {
        position: relative;
        display: flex;
        width: 100%;
        min-height: 8rem;
        overflow: hidden;
        border-radius: var(--radius-large);
    }
    .page-card {
        position: relative;
        z-index: 10;
        width: 100%;
        padding: 1.5rem 2.25rem;
    }
    .content {
        margin-top: 0.5rem;
    }
</style>
