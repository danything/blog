---

import ConfigCarrier from "@components/ConfigCarrier.astro";
import { siteConfig } from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import I18nKey from "../i18n/i18nKey";
import { i18n, langFromPath, siteText } from "../i18n/translation";
import type { Favicon } from "../types/config";
import { getAlternates } from "../utils/content-utils";
import { localeUrl, pathsEqual, stripLang, url } from "../utils/url-utils";
import "../styles/main.css";
import { ClientRouter } from "astro:transitions";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	/** OGP 画像(public 配下の絶対パス)。無ければサイト共通の画像 */
	ogImage?: string;
}

let {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	ogImage: ogImagePath,
} = Astro.props;

// ページの言語(/en/ 以下なら英語)。UI の文言・RSS・hreflang はこれで決める
const pageLang = langFromPath(Astro.url.pathname);
const text = siteText(pageLang);
// 日本語版と英語版の両方があるページなら、互いを hreflang で示す
const alternates = await getAlternates(Astro.url.pathname);

// 検索結果とシェア用。記事以外は description が無いのでサイトの説明を使う
const metaDescription = description || text.description;
// 正規 URL(クエリや表記ゆれを除く)。404 には付けない
const canonicalUrl = stripLang(Astro.url.pathname).startsWith(url("/404"))
	? undefined
	: new URL(Astro.url.pathname, Astro.site).href;
// 記事のアイキャッチ(public 配下の絶対パス)があればそれ、次に記事ごとに作った画像、無ければサイト共通の画像
const ogImage = new URL(
	banner?.startsWith("/") ? banner : (ogImagePath ?? siteConfig.ogImage),
	Astro.site,
).href;

// apply a class to the body element to decide the height of the banner
// ClientRouter swaps the body on each navigation, so the class follows the new page
const isHomePage = pathsEqual(Astro.url.pathname, localeUrl("/", pageLang));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${text.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

if (!lang) {
	lang = pageLang;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px]" transition:animate="none">
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription}>
		<meta name="author" content={text.profileName}>

		{canonicalUrl && <link rel="canonical" href={canonicalUrl}>}
		{alternates && Object.entries(alternates).map(([l, path]) => (
			<link rel="alternate" hreflang={l} href={new URL(path, Astro.site).href}>
		))}
		{alternates && <link rel="alternate" hreflang="x-default" href={new URL(alternates[siteConfig.lang], Astro.site).href}>}

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:locale" content={pageLang === "en" ? "en_US" : "ja_JP"}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={metaDescription}>
		<meta property="og:image" content={ogImage}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={metaDescription}>
		<meta name="twitter:image" content={ogImage}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<!-- Threads との双方向認証 (プロフィールのリンク横にダブルアローが付く)。
		     サイドバーの SNS アイコンにも rel="me" は付いているが、サイドバーの
		     無いページでも検証が通るよう head に置く -->
		<link rel="me" href="https://www.threads.com/@5yuim" />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue}}>
			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>

		<ClientRouter />

		<link rel="alternate" type="application/rss+xml" title={text.profileName} href={new URL(localeUrl("/rss.xml", pageLang), Astro.site).href}/>

	</head>
	<body class=" min-h-screen transition " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}>
		<ConfigCarrier></ConfigCarrier>
		<slot />
		<!-- 記事の画像の拡大表示(下のスクリプトと styles/lightbox.css) -->
		<dialog id="lightbox" class="lightbox" aria-label={i18n(I18nKey.imageViewer, pageLang)} data-enlarge={i18n(I18nKey.enlargeImage, pageLang)}>
			<div class="lightbox-scroller">
				<img class="lightbox-image" alt="">
			</div>
			<div class="lightbox-toolbar">
				<button type="button" class="lightbox-zoom" aria-pressed="false" aria-label={i18n(I18nKey.actualSize, pageLang)} hidden>
					<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff" aria-hidden="true"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>
				</button>
				<button type="button" class="lightbox-close" aria-label={i18n(I18nKey.close, pageLang)} autofocus>
					<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff" aria-hidden="true"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>
				</button>
			</div>
		</dialog>

	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@reference "../styles/main.css";
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
}
</style>

<script>
import {getHue, getStoredTheme, setHue, setTheme} from "../utils/setting-utils";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_HOME,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT
} from "../constants/constants";
import { siteConfig } from '../config';

function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;		// Ensure the event target is an HTML Node
		for (let ig of ignores) {
			let ie = document.getElementById(ig)
			if (ie == tDom || (ie?.contains(tDom))) {
				return;
			}
		}
		panelDom?.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])

// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
function setBannerHeightExtend() {
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - offset % 4;
	document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
}

// テーマ・色相・バナーの高さは <html> に付けている。ClientRouter はページ遷移のたびに
// <html> の属性を新しいページのもので置き換えるので、入れ替えの直後に付け直す
function applySettings() {
	setTheme(getStoredTheme());
	setHue(getHue());
	setBannerHeightExtend();
}
applySettings();
document.addEventListener('astro:after-swap', () => {
	applySettings();
	// 本文の出現を遅らせるのは最初の表示だけ
	document.documentElement.style.setProperty('--content-delay', '0ms');
});

function showBanner() {
	if (!siteConfig.banner.enable) return;
	document.getElementById('banner')?.classList.remove('opacity-0', 'scale-105');
}

// 要素はページ遷移で入れ替わるので、毎回取り直す
function scrollFunction() {
	const bannerEnabled = !!document.getElementById('banner-wrapper')
	const scrollTop = Math.max(document.body.scrollTop, document.documentElement.scrollTop)
	const bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100)

	document.getElementById('back-to-top-btn')?.classList.toggle('hide', scrollTop <= bannerHeight)

	if (!bannerEnabled) return
	document.getElementById('toc-wrapper')?.classList.toggle('toc-hide', scrollTop <= bannerHeight)

	const navbar = document.getElementById('navbar-wrapper')
	if (navbar) {
		const NAVBAR_HEIGHT = 72
		const MAIN_PANEL_EXCESS_HEIGHT = MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16			// The height the main panel overlaps the banner
		const height = document.body.classList.contains('lg:is-home') && window.innerWidth >= 1024 ? BANNER_HEIGHT_HOME : BANNER_HEIGHT
		const threshold = window.innerHeight * (height / 100) - NAVBAR_HEIGHT - MAIN_PANEL_EXCESS_HEIGHT - 16
		navbar.classList.toggle('navbar-hidden', scrollTop >= threshold)
	}
}
window.addEventListener('scroll', scrollFunction, { passive: true })
window.addEventListener('resize', setBannerHeightExtend)

document.addEventListener('astro:page-load', () => {
	showBanner();
	scrollFunction();
});
</script>

<script>
// 記事の画像を押す(Enter・Space でも)と、#lightbox に画面いっぱいで出す。
// 画面に収まらない大きな画像は、画像か虫眼鏡のボタンを押すと実際の大きさになり、スクロールして見られる。
// 閉じるのは閉じるボタン・Esc・画像の外側を押したとき(実際の大きさにできない画像は、画像を押しても閉じる)。
// リンクになっている画像はリンクのまま動かす
const TRIGGERS = ".custom-md img:not(a img), #post-cover img"

function getParts() {
	const dialog = document.getElementById("lightbox")
	if (!(dialog instanceof HTMLDialogElement)) return
	const image = dialog.querySelector<HTMLImageElement>(".lightbox-image")
	const zoom = dialog.querySelector<HTMLButtonElement>(".lightbox-zoom")
	if (!image || !zoom) return
	return { dialog, image, zoom }
}

/** 実際の大きさにすると、画面に合わせたときより大きくなるか */
function updateZoomable() {
	const parts = getParts()
	if (!parts || parts.dialog.classList.contains("zoomed")) return
	const { dialog, image, zoom } = parts
	const zoomable =
		image.naturalWidth > image.clientWidth + 1 || image.naturalHeight > image.clientHeight + 1
	dialog.classList.toggle("zoomable", zoomable)
	zoom.hidden = !zoomable
}

/** 実際の大きさとの切り替え。x, y(画面上の位置)にある画像の点が、切り替えた後も同じ位置に来るようにする */
function setZoom(on: boolean, x = innerWidth / 2, y = innerHeight / 2) {
	const parts = getParts()
	if (!parts) return
	const { dialog, image, zoom } = parts
	const before = image.getBoundingClientRect()
	dialog.classList.toggle("zoomed", on)
	zoom.setAttribute("aria-pressed", String(on))
	if (!on) return
	const after = image.getBoundingClientRect()
	const scroller = image.parentElement
	if (!scroller) return
	scroller.scrollLeft += after.left + ((x - before.left) / before.width) * after.width - x
	scroller.scrollTop += after.top + ((y - before.top) / before.height) * after.height - y
}

function open(source: HTMLImageElement) {
	const parts = getParts()
	if (!parts) return
	const { dialog, image } = parts
	setZoom(false)
	image.alt = source.alt
	image.src = source.currentSrc || source.src
	dialog.showModal()
	if (image.complete) updateZoomable()
	else image.addEventListener("load", updateZoomable, { once: true })
}

// 本文はページ遷移で入れ替わるので、ページごとに印を付け直す
document.addEventListener("astro:page-load", () => {
	const label = getParts()?.dialog.dataset.enlarge ?? ""
	for (const img of document.querySelectorAll<HTMLImageElement>(TRIGGERS)) {
		img.classList.add("lightbox-trigger")
		img.tabIndex = 0
		img.setAttribute("role", "button")
		img.setAttribute("aria-haspopup", "dialog")
		img.setAttribute("aria-label", img.alt ? `${label}: ${img.alt}` : label)
		// alt="" は飾りの画像という印で、ボタンの役割と矛盾する。名前は aria-label で付けたので外す
		if (img.getAttribute("alt") === "") img.removeAttribute("alt")
	}
})

/** 実際の大きさで出しているときのスクロールバーを押したか(押しても閉じない) */
function onScrollbar(e: MouseEvent) {
	const el = e.target
	if (!(el instanceof HTMLElement) || !el.matches(".lightbox-scroller")) return false
	const rect = el.getBoundingClientRect()
	return e.clientX - rect.left >= el.clientWidth || e.clientY - rect.top >= el.clientHeight
}

// ダイアログもページ遷移で入れ替わるので、イベントは document で受ける
document.addEventListener("click", (e) => {
	if (!(e.target instanceof Element)) return
	const trigger = e.target.closest<HTMLImageElement>(".lightbox-trigger")
	if (trigger) {
		e.preventDefault()
		open(trigger)
		return
	}
	const parts = getParts()
	if (!parts?.dialog.contains(e.target)) return
	const { dialog, image } = parts
	const zoomed = dialog.classList.contains("zoomed")
	if (e.target.closest(".lightbox-zoom")) setZoom(!zoomed)
	else if (e.target === image && dialog.classList.contains("zoomable"))
		setZoom(!zoomed, e.clientX, e.clientY)
	else if (e.target.closest(".lightbox-close")) dialog.close()
	else if (!e.target.closest(".lightbox-toolbar") && !onScrollbar(e)) dialog.close()
})

document.addEventListener("keydown", (e) => {
	if (e.key !== "Enter" && e.key !== " ") return
	if (!(e.target instanceof Element) || !e.target.matches(".lightbox-trigger")) return
	e.preventDefault()
	open(e.target as HTMLImageElement)
})

window.addEventListener("resize", updateZoomable)
</script>
