---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Icon from "@components/misc/Icon.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	ogImage?: string;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	ogImage,
	headings = [],
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} ogImage={ogImage}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row">
    <div id="navbar-wrapper">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class="banner-hidden"
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper>
</div>}

<!-- Main content -->
<div class="main-layer" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events: none here prevent blocking the click event of the TOC -->
    <div class="main-column">
        <div id="main-grid">
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["onload-animation", {"has-link": hasBannerLink}]}
            >
                <Icon class="credit-icon" name="lucide:copyright" ></Icon>
                <div class="credit-text">{siteConfig.banner.credit.text}</div>
                <Icon class="credit-link-icon" name="lucide:external-link">
                </Icon>
            </a>}


            <SideBar class="sidebar onload-animation" headings={headings}></SideBar>

            <main id="main-content">
                <div id="content-wrapper" class="onload-animation">
                    <!-- the overflow: hidden here prevent long text break the layout-->
                    <slot></slot>
                    <div class="footer footer-wide onload-animation">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <div class="footer footer-narrow onload-animation">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
    </div>
</div>

<!-- The things that should be under the banner, only the TOC for now -->
<div class="toc-layer">
    <div class="toc-column">
        <!-- TOC component -->
        {siteConfig.toc.enable && <div id="toc-wrapper" class:list={{"toc-hide": siteConfig.banner.enable}}>
            <div id="toc-inner-wrapper">
                <div id="toc">
                    <div class="toc-spacer"></div>
                    <TOC headings={headings}></TOC>
                    <div class="toc-spacer"></div>
                </div>
            </div>
        </div>}

    </div>
</div>
</Layout>

<style>
    #top-row {
        position: relative;
        z-index: 50;
        max-width: var(--page-width);
        margin-inline: auto;
        padding-inline: 0;
        pointer-events: none;
        transition: all 0.7s var(--ease);

        @media (width >= 48rem) {
            padding-inline: 1rem;
        }
    }
    #navbar-wrapper {
        position: sticky;
        top: 0;
        pointer-events: auto;
        transition: all 0.15s var(--ease);
    }

    #banner-wrapper {
        position: absolute;
        z-index: 10;
        width: 100%;
        overflow: hidden;
        transition: var(--transition);
        transition-duration: 0.7s;
    }
    #banner {
        height: 100%;
        object-fit: cover;
        transition: var(--transition);
        transition-duration: 0.7s;

        /* 読み込みが終わるまで(Layout.astro のスクリプトが外す) */
        &.banner-hidden {
            opacity: 0;
            scale: 1.05;
        }
    }

    .main-layer {
        position: absolute;
        z-index: 30;
        width: 100%;
        pointer-events: none;
    }
    .main-column {
        position: relative;
        max-width: var(--page-width);
        margin-inline: auto;
        pointer-events: auto;
    }
    /* 狭い画面では本文の下にサイドバー、広い画面では左にサイドバー */
    #main-grid {
        display: grid;
        grid-template-columns: 17.5rem auto;
        grid-template-rows: auto 1fr auto;
        gap: 1rem;
        left: 0;
        right: 0;
        width: 100%;
        margin-inline: auto;
        padding-inline: 0;
        transition: var(--transition);
        transition-duration: 0.7s;

        @media (width >= 48rem) {
            padding-inline: 1rem;
        }
        @media (width >= 64rem) {
            grid-template-rows: auto;
        }
    }
    .sidebar {
        grid-column: span 2 / span 2;
        grid-row: 2 / 3;
        margin-bottom: 1rem;

        @media (width >= 64rem) {
            grid-column: span 1 / span 1;
            grid-row: 1 / 2;
            max-width: 17.5rem;
        }
    }
    #main-content {
        grid-column: span 2 / span 2;
        overflow: hidden;

        @media (width >= 64rem) {
            grid-column: span 1 / span 1;
        }
    }
    /* フッターは広い画面では本文の下、狭い画面ではサイドバーの下 */
    .footer {
        grid-column: span 2 / span 2;
    }
    .footer-wide {
        display: none;

        @media (width >= 64rem) {
            display: block;
        }
    }
    .footer-narrow {
        display: block;

        @media (width >= 64rem) {
            display: none;
        }
    }

    #banner-credit {
        position: absolute;
        top: -3.25rem;
        right: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 2.25rem;
        padding-inline: 0.75rem;
        border-radius: calc(infinity * 1px);
        background-color: color-mix(in oklab, var(--black) 60%, transparent);
        transition: all 0.15s var(--ease);

        @media (hover: hover) {
            &:hover {
                background-color: color-mix(in oklab, var(--black) 70%, transparent);
            }
            &.has-link:hover {
                padding-right: 2.25rem;
            }
            &.has-link:hover .credit-link-icon {
                opacity: 1;
            }
        }
        &.has-link:active {
            background-color: color-mix(in oklab, var(--black) 80%, transparent);
        }
    }
    .credit-icon {
        margin-right: 0.25rem;
        font-size: 1.25rem;
        color: color-mix(in oklab, var(--white) 75%, transparent);
    }
    .credit-text {
        font-size: var(--text-xs);
        line-height: var(--text-xs-lh);
        color: color-mix(in oklab, var(--white) 75%, transparent);
    }
    .credit-link-icon {
        position: absolute;
        right: 1rem;
        font-size: 0.75rem;
        color: oklch(0.75 0.14 var(--hue));
        opacity: 0;
        transition: var(--transition);
    }

    /* 目次はカードより後ろの層に、ページの右の余白に置く */
    .toc-layer {
        display: none;
        position: absolute;
        z-index: 0;
        width: 100%;

        @media (width >= 96rem) {
            display: block;
        }
    }
    .toc-column {
        position: relative;
        max-width: var(--page-width);
        margin-inline: auto;
    }
    #toc-wrapper {
        display: none;
        position: absolute;
        top: 0;
        right: calc(var(--toc-width) * -1);
        align-items: center;
        width: var(--toc-width);
        transition: var(--transition);

        @media (width >= 64rem) {
            display: block;
        }
        /* バナーがあるときは、スクロールするまで隠す(Layout.astro のスクリプト) */
        &.toc-hide {
            opacity: 0;
            pointer-events: none;
        }
    }
    /* 目次が長いときはこの中でスクロールする(スクロールバーは出さず、上下の端をぼかす) */
    #toc-inner-wrapper {
        position: fixed;
        top: 3.5rem;
        width: var(--toc-width);
        height: calc(100vh - 20rem);
        overflow-x: hidden;
        overflow-y: scroll;
        scrollbar-width: none;
        mask-image: linear-gradient(to bottom, transparent 0%, black 2rem, black calc(100% - 2rem), transparent 100%);

        &::-webkit-scrollbar {
            display: none;
        }
    }
    #toc {
        width: 100%;
        height: 100%;
    }
    .toc-spacer {
        width: 100%;
        height: 2rem;
    }
</style>
