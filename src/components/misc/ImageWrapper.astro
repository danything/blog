---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

// 呼び出し元の <style> が効くよう、残りの属性(data-astro-cid-*)も外側の要素に付ける
const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	class: className,
	...rest
} = Astro.props;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	// 画像だけに絞る。"../../**" だと src 以下の CSS なども全部モジュールとして取り込んでいた
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,gif,avif,svg}",
		{ import: "default" },
	);
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	} else {
		img = await file();
	}
}

const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, "image-wrapper"]} {...rest}>
    <div class="dim"></div>
    {isLocal && img && <Image src={img} alt={alt || ""} class="image" style={imageStyle}/>}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class="image" style={imageStyle}/>}
</div>

<style>
    .image-wrapper {
        position: relative;
        overflow: hidden;
    }
    /* ダークモードでは少し暗くする */
    .dim {
        position: absolute;
        inset: 0;
        pointer-events: none;
        transition: var(--transition);

        :global(.dark) & {
            background-color: color-mix(in oklab, var(--black) 10%, transparent);
        }
    }
    .image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>
