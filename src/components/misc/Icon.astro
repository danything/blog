---
// src/icons.json(bun run icons で生成)のアイコンを SVG として埋め込む
import icons from "../../icons.json";

interface Props {
	name: string;
	class?: string;
}

const { name, class: className } = Astro.props;
const icon = (icons as Record<string, { viewBox: string; body: string }>)[name];
if (!icon)
	throw new Error(
		`アイコン ${name} が src/icons.json にありません(bun run icons を実行)`,
	);
---
<svg width="1em" height="1em" viewBox={icon.viewBox} class={className} data-icon={name} set:html={icon.body} />
