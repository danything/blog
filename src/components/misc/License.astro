---
import Icon from "@components/misc/Icon.astro";
import { licenseConfig, siteText } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n, langFromPath } from "../../i18n/translation";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

interface Props {
	title: string;
	slug: string;
	pubDate: Date;
	class: string;
}

// 呼び出し元の <style> が効くよう、残りの属性(data-astro-cid-*)も外側の要素に付ける
const { title, pubDate, slug: _slug, class: className, ...rest } = Astro.props;
const postUrl = decodeURIComponent(Astro.url.toString());
const lang = langFromPath(Astro.url.pathname);
---
<div class:list={["license", className]} {...rest}>
    <div class="title">
        {title}
    </div>
    <a href={postUrl} class="link">
        {postUrl}
    </a>
    <div class="details">
        <div>
            <div class="label text-sm">{i18n(I18nKey.author, lang)}</div>
            <div class="value">{siteText.ja.profileName}</div>
        </div>
        <div>
            <div class="label text-sm">{i18n(I18nKey.publishedAt, lang)}</div>
            <div class="value">{formatDateToYYYYMMDD(pubDate)}</div>
        </div>
        <div>
            <div class="label text-sm">{i18n(I18nKey.license, lang)}</div>
            <a href={licenseConfig.url} target="_blank" class="link value-link">{licenseConfig.name}</a>
        </div>
    </div>
    <Icon name="simple-icons:creativecommons" class="cc-icon"></Icon>
</div>

<style>
    .license {
        position: relative;
        padding: 1.25rem 1.5rem;
        overflow: hidden;
        background-color: var(--license-block-bg);
        transition: var(--transition);
    }
    .title {
        font-weight: 700;
        color: var(--text-75);
        transition: var(--transition);
    }
    .link {
        color: var(--primary);
    }
    .details {
        display: flex;
        gap: 1.5rem;
        margin-top: 0.5rem;
    }
    .label {
        color: var(--text-30);
        transition: var(--transition);
    }
    .value,
    .value-link {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }
    .value {
        color: var(--text-75);
        transition: var(--transition);
    }
    /* 右に大きく薄く出す CC のマーク */
    .cc-icon {
        position: absolute;
        top: 50%;
        right: 1.5rem;
        font-size: 15rem;
        color: var(--fg-5);
        translate: 0 -50%;
        pointer-events: none;
        transition: var(--transition);
    }
</style>
