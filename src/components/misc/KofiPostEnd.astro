---
import Icon from "@components/misc/Icon.astro";
import { kofiConfig } from "@/config";
import { langFromPath, siteText } from "../../i18n/translation";

// 記事を読み終えたところに出す応援の欄。サイドバーの応援は一番下にあって
// スクロールしないと見えないので、記事の末尾にも置く(中身はサイドバーと同じ)
interface Props {
	class?: string;
}
// 呼び出し元の <style> が効くよう、残りの属性(data-astro-cid-*)も外側の要素に付ける
const { class: className, ...rest } = Astro.props;
const url = `https://ko-fi.com/${kofiConfig.username}`;
const text = siteText(langFromPath(Astro.url.pathname)).kofi;
---
{kofiConfig.enable && kofiConfig.username && (
<div class:list={["kofi", className]} {...rest}>
    <div class="description">
        {text.description}
    </div>
    <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-regular kofi-button"
    >
        <Icon name="simple-icons:kofi" class="kofi-icon" aria-hidden="true"></Icon>
        {text.buttonLabel}
    </a>
</div>
)}

<style>
    .kofi {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1rem 1.5rem;
        border-radius: 0.75rem;
        background-color: var(--license-block-bg);
        transition: var(--transition);

        @media (width >= 40rem) {
            flex-direction: row;
            align-items: center;
        }
    }
    .description {
        flex: 1;
        font-size: var(--text-sm);
        line-height: var(--text-sm-lh);
        color: var(--text-75);
        transition: var(--transition);
    }
    .kofi-button {
        flex-shrink: 0;
        gap: 0.5rem;
        height: 2.25rem;
        padding-inline: 1rem;
        border-radius: 0.5rem;
        font-size: var(--text-sm);
        line-height: var(--text-sm-lh);
        font-weight: 700;
    }
    .kofi-icon {
        font-size: 1.1rem;
    }
</style>
