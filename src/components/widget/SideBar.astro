---
import { langFromPath } from "../../i18n/translation";
import Categories from "./Categories.astro";
import Kofi from "./Kofi.astro";
import Newsletter from "./Newsletter.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
}

// 呼び出し元の <style> が効くよう、残りの属性(data-astro-cid-*)も外側の要素に付ける
const { class: className, ...rest } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
---
<div id="sidebar" class={className} {...rest}>
    <div class="profile-area">
        <Profile></Profile>
    </div>
    <div id="sidebar-sticky">
        <Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
        <Tag class="onload-animation" style="animation-delay: 200ms"></Tag>
        <!-- ニュースレターは日本語の記事だけを送るので、英語版には出さない -->
        {lang === "ja" && <Newsletter class="onload-animation" style="animation-delay: 250ms"></Newsletter>}
        <Kofi class="onload-animation" style="animation-delay: 300ms"></Kofi>
    </div>
</div>

<style>
    #sidebar {
        width: 100%;
    }
    .profile-area,
    #sidebar-sticky {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
    }
    .profile-area {
        margin-bottom: 1rem;
    }
    /* プロフィールより下はスクロールしても画面に残す */
    #sidebar-sticky {
        position: sticky;
        top: 1rem;
        transition: all 0.7s var(--ease);
    }
</style>
