---
import Icon from "@components/misc/Icon.astro";
import { kofiConfig } from "@/config";
import { langFromPath, siteText } from "../../i18n/translation";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;

// 外部スクリプトを読み込まず、Ko-fi のページへリンクするだけの実装。
// 表示速度とテーマ追従を優先している。
const url = `https://ko-fi.com/${kofiConfig.username}`;
const text = siteText(langFromPath(Astro.url.pathname)).kofi;
---
{kofiConfig.enable && kofiConfig.username && (
<WidgetLayout name={text.title} id="kofi" class={className} style={style}>
    <div class="description">
        {text.description}
    </div>
    <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={text.buttonLabel}
        class="btn-regular kofi-button"
    >
        <Icon name="simple-icons:kofi" class="kofi-icon"></Icon>
        {text.buttonLabel}
    </a>
</WidgetLayout>
)}

<style>
    .description {
        margin-bottom: 0.75rem;
        font-size: var(--text-sm);
        line-height: var(--text-sm-lh);
        color: var(--text-75);
        transition: var(--transition);
    }
    .kofi-button {
        gap: 0.5rem;
        width: 100%;
        height: 2.25rem;
        border-radius: 0.5rem;
        font-size: var(--text-sm);
        line-height: var(--text-sm-lh);
        font-weight: 700;
    }
    .kofi-icon {
        font-size: 1.1rem;
    }
</style>
