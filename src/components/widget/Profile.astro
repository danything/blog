---
import Icon from "@components/misc/Icon.astro";
import { profileConfig } from "../../config";
import { langFromPath, siteText } from "../../i18n/translation";
import { localeUrl } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
const lang = langFromPath(Astro.url.pathname);
const text = siteText(lang);
---
<div class="card-base profile">
    <a aria-label="Go to About Page" href={localeUrl('/about/', lang)} class="avatar-link">
        <div class="avatar-overlay">
            <Icon name="lucide:id-card" class="avatar-icon"></Icon>
        </div>
        <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="avatar"></ImageWrapper>
    </a>
    <div class="info">
        <div class="name">{text.profileName}</div>
        <div class="divider"></div>
        <div class="bio">{text.bio}</div>
        <div class="links">
            {config.links.length > 1 && config.links.map(item =>
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-regular social-link">
                        <Icon name={item.icon} class="social-icon"></Icon>
                    </a>
            )}
            {config.links.length == 1 && <a rel="me" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                            class="btn-regular social-link single">
                <Icon name={config.links[0].icon} class="social-icon"></Icon>
                {config.links[0].name}
            </a>}
        </div>
    </div>
</div>

<style>
    .profile {
        padding: 0.75rem;
    }
    /* アイコンの画像。マウスを乗せると暗くなって About へのリンクだと分かる */
    .avatar-link {
        position: relative;
        display: block;
        max-width: 12rem;
        margin: 0.25rem auto 0.75rem;
        overflow: hidden;
        border-radius: 0.75rem;

        &:active {
            scale: 0.95;
        }
        @media (width >= 64rem) {
            max-width: none;
            margin-inline: 0;
            margin-top: 0;
        }
    }
    .avatar-overlay {
        position: absolute;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        pointer-events: none;
        transition: var(--transition);
    }
    .avatar-icon {
        font-size: 3rem;
        line-height: 1;
        color: white;
        opacity: 0;
        scale: 0.9;
        transition: var(--transition);
    }
    @media (hover: hover) {
        .avatar-link:hover {
            .avatar-overlay {
                background-color: color-mix(in oklab, var(--black) 30%, transparent);
            }
            .avatar-icon {
                opacity: 1;
                scale: 1;
            }
        }
    }
    .avatar-link:active .avatar-overlay {
        background-color: color-mix(in oklab, var(--black) 50%, transparent);
    }
    .avatar {
        height: 100%;
        margin-inline: auto;

        @media (width >= 64rem) {
            width: 100%;
            margin-top: 0;
        }
    }
    .info {
        padding-inline: 0.5rem;
    }
    .name {
        margin-bottom: 0.25rem;
        font-size: var(--text-xl);
        line-height: var(--text-xl-lh);
        font-weight: 700;
        text-align: center;
        transition: var(--transition);

        :global(.dark) & {
            color: var(--neutral-50);
        }
    }
    .divider {
        width: 1.25rem;
        height: 0.25rem;
        margin: 0 auto 0.5rem;
        border-radius: calc(infinity * 1px);
        background-color: var(--primary);
        transition: var(--transition);
    }
    .bio {
        margin-bottom: 0.625rem;
        text-align: center;
        color: var(--neutral-400);
        transition: var(--transition);
    }
    .links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 0.25rem;
    }
    .social-link {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.5rem;

        &:active {
            scale: 0.9;
        }
        &.single {
            width: auto;
            gap: 0.5rem;
            padding-inline: 0.75rem;
            font-weight: 700;

            &:active {
                scale: 0.95;
            }
        }
    }
    .social-icon {
        font-size: 1.5rem;
    }
</style>
