---
import Icon from "@components/misc/Icon.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n, type Lang } from "@i18n/translation";
import { siteConfig } from "@/config";

interface Props {
	lang: Lang;
}

const title = i18n(I18nKey.themeColor, Astro.props.lang);
// 保存された色相はスクリプトで反映する。ここでは既定の色相で描いておく
const hue = siteConfig.themeColor.hue;
---
<div id="display-setting" class="float-panel float-panel-closed" role="group"
     aria-label={title}>
    <div class="header">
        <div class="title text-lg">
            {title}
            {/* 既定の色のときは見えないので、Tab で止まらないよう disabled にする */}
            <button id="hue-reset" aria-label={i18n(I18nKey.resetToDefault, Astro.props.lang)} class="btn-regular" disabled>
                <div class="reset-icon">
                    <Icon name="lucide:rotate-ccw" class="reset-icon-svg" />
                </div>
            </button>
        </div>
        <div class="hue-value-wrapper">
            <div id="hueValue" class="text-sm">
                {hue}
            </div>
        </div>
    </div>
    <div class="slider-track">
        <input aria-label={title} type="range" min="0" max="360" value={hue}
               class="slider" id="colorSlider" step="5" style="width: 100%">
    </div>
</div>

<style>
	#display-setting {
	  position: absolute;
	  right: 1rem;
	  width: 20rem;
	  padding: 1rem;
	}
	.header {
	  display: flex;
	  align-items: center;
	  justify-content: space-between;
	  gap: 0.5rem;
	  margin-bottom: 0.75rem;
	}
	/* 見出しの左の縦線は ::before で描く */
	.title {
	  position: relative;
	  display: flex;
	  gap: 0.5rem;
	  margin-left: 0.75rem;
	  font-weight: 700;
	  color: var(--heading-color);
	  transition: var(--transition);
	  &::before {
	    content: "";
	    position: absolute;
	    top: 0.33rem;
	    left: -0.75rem;
	    width: 0.25rem;
	    height: 1rem;
	    border-radius: 0.375rem;
	    background-color: var(--primary);
	  }
	}
	#hue-reset {
	  width: 1.75rem;
	  height: 1.75rem;
	  border-radius: 0.375rem;
	  will-change: transform;

	  &:active {
	    scale: 0.9;
	  }
	  /* 既定の色のときは隠す */
	  &:disabled {
	    opacity: 0;
	    pointer-events: none;
	  }
	}
	.reset-icon {
	  color: var(--btn-content);
	}
	.reset-icon-svg {
	  font-size: 0.875rem;
	}
	.hue-value-wrapper {
	  display: flex;
	  gap: 0.25rem;
	}
	#hueValue {
	  display: flex;
	  align-items: center;
	  justify-content: center;
	  width: 2.5rem;
	  height: 1.75rem;
	  border-radius: 0.375rem;
	  background-color: var(--btn-regular-bg);
	  font-weight: 700;
	  color: var(--btn-content);
	  transition: var(--transition);
	}
	.slider-track {
	  width: 100%;
	  height: 1.5rem;
	  padding-inline: 0.25rem;
	  border-radius: 0.25rem;
	  background-color: oklch(0.8 0.1 0);
	  user-select: none;

	  :global(.dark) & {
	    background-color: oklch(0.7 0.1 0);
	  }
	}
	#display-setting input[type="range"] {
	  -webkit-appearance: none;
	  height: 1.5rem;
	  background-image: var(--color-selection-bar);
	  transition: background-image 0.15s ease-in-out;
	/* Input Thumb */
	}
	#display-setting input[type="range"]::-webkit-slider-thumb {
	  -webkit-appearance: none;
	  height: 1rem;
	  width: 0.5rem;
	  border-radius: 0.125rem;
	  background: rgba(255,255,255,0.7);
	  box-shadow: none;
	}
	#display-setting input[type="range"]::-webkit-slider-thumb:hover {
	  background: rgba(255,255,255,0.8);
	}
	#display-setting input[type="range"]::-webkit-slider-thumb:active {
	  background: rgba(255,255,255,0.6);
	}
	#display-setting input[type="range"]::-moz-range-thumb {
	  -webkit-appearance: none;
	  height: 1rem;
	  width: 0.5rem;
	  border-radius: 0.125rem;
	  border-width: 0;
	  background: rgba(255,255,255,0.7);
	  box-shadow: none;
	}
	#display-setting input[type="range"]::-moz-range-thumb:hover {
	  background: rgba(255,255,255,0.8);
	}
	#display-setting input[type="range"]::-moz-range-thumb:active {
	  background: rgba(255,255,255,0.6);
	}
</style>

<script>
import { onActivatedFromPrerender } from "@utils/prerender";
import { DEFAULT_HUE, getHue, setHue } from "@utils/setting-utils";

function setup(panel: HTMLElement) {
	const slider = panel.querySelector<HTMLInputElement>("#colorSlider");
	const reset = panel.querySelector<HTMLButtonElement>("#hue-reset");
	const value = panel.querySelector<HTMLElement>("#hueValue");
	if (!slider || !reset || !value) return;

	const update = (hue: number) => {
		setHue(hue);
		slider.value = String(hue);
		value.textContent = String(hue);
		const isDefault = hue === DEFAULT_HUE;
		reset.disabled = isDefault;
	};

	slider.addEventListener("input", () => update(Number(slider.value)));
	reset.addEventListener("click", () => {
		// 戻すとこのボタンは押せなく(disabled に)なるので、キーボードで押したときはスライダーへ移す
		const focused = document.activeElement === reset;
		update(DEFAULT_HUE);
		if (focused) slider.focus();
	});
	// Esc で閉じて、開いたボタンへ戻る
	panel.addEventListener("keydown", (e) => {
		if (e.key !== "Escape") return;
		panel.classList.add("float-panel-closed");
		document.getElementById("display-settings-switch")?.focus();
	});

	update(getHue());
	onActivatedFromPrerender(() => update(getHue()));
}

const panel = document.getElementById("display-setting");
if (panel) setup(panel);
</script>
