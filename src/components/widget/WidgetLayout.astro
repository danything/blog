---
import Icon from "@components/misc/Icon.astro";
import I18nKey from "../../i18n/i18nKey";
import { i18n, langFromPath } from "../../i18n/translation";

interface Props {
	id: string;
	name?: string;
	isCollapsed?: boolean;
	collapsedHeight?: string;
	class?: string;
	style?: string;
}
const { id, name, isCollapsed, collapsedHeight, style } = Astro.props;
const className = Astro.props.class;
const lang = langFromPath(Astro.url.pathname);
---
<widget-layout data-id={id} data-is-collapsed={String(isCollapsed)} class:list={["card-base widget", className]} style={style}>
    <div class="widget-title text-lg">{name}</div>
    <div id={id} class:list={["collapse-wrapper", {"collapsed": isCollapsed}]}>
        <slot></slot>
    </div>
    {isCollapsed && <div class="expand-btn">
        <button class="btn-plain">
            <div class="expand-label">
                <Icon name="lucide:ellipsis" class="expand-icon"></Icon> {i18n(I18nKey.more, lang)}
            </div>
        </button>
    </div>}
</widget-layout>

<style define:vars={{ collapsedHeight }}>
    .widget {
        padding-bottom: 1rem;
    }
    /* 見出しの左の縦線は ::before で描く */
    .widget-title {
        position: relative;
        margin: 1rem 0 0.5rem 2rem;
        font-weight: 700;
        color: var(--heading-color);
        transition: var(--transition);
        &::before {
            content: "";
            position: absolute;
            top: 5.5px;
            left: -16px;
            width: 0.25rem;
            height: 1rem;
            border-radius: 0.375rem;
            background-color: var(--primary);
        }
    }
    .collapse-wrapper {
        padding-inline: 1rem;
        overflow: hidden;
    }
    /* 長いときは「もっと見る」を押すまで縮めておく */
    .collapsed {
        height: var(--collapsedHeight);
    }
    .expand-btn {
        margin-bottom: -0.5rem;
        padding-inline: 1rem;

        button {
            width: 100%;
            height: 2.25rem;
            border-radius: 0.5rem;
        }
    }
    .expand-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: var(--primary);
        translate: -0.5rem;
    }
    .expand-icon {
        font-size: 1.75rem;
    }
</style>

<script>
    class WidgetLayout extends HTMLElement {
        constructor() {
            super();

            if (this.dataset.isCollapsed !== "true")
                return;

            const id = this.dataset.id;
            const btn = this.querySelector<HTMLElement>('.expand-btn');
            const wrapper = this.querySelector(`#${id}`)
            btn!.addEventListener('click', () => {
                wrapper!.classList.remove('collapsed');
                btn!.hidden = true;
            })
        }
    }

    customElements.define("widget-layout", WidgetLayout);
</script>
