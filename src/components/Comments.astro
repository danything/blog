---
import "@/styles/yosegaki.css";
import { commentConfig } from "@/config";
---
<div class="comments">
    <div class="card-base comments-card">
        <div id="yosegaki" data-server={commentConfig.server}></div>
    </div>
</div>

<style>
    .comments {
        position: relative;
        display: flex;
        width: 100%;
        margin-bottom: 1rem;
        border-radius: var(--radius-large);
    }
    .comments-card {
        position: relative;
        z-index: 10;
        width: 100%;
        padding: 1.5rem;

        @media (width >= 48rem) {
            padding-inline: 2.25rem;
        }
    }
</style>

<script>
// サーバの URL は設定(config.ts)をクライアントの JS に入れないよう、data-server で受け取る
import { whenActivated } from "@/utils/prerender";

declare global {
	interface Window {
		Yosegaki?: {
			init: (opts: Record<string, unknown>) => unknown;
		};
	}
}

function mount(target: HTMLElement, server: string) {
	if (!window.Yosegaki) {
		console.error(`[comments] yosegaki を読み込めませんでした (${server}/embed.js)`);
		return;
	}

	window.Yosegaki.init({
		target,
		server,
		lang: document.documentElement.lang === "en" ? "en" : "ja",
		// クエリ文字列でスレッドが分かれないよう URL を明示する
		page: location.origin + location.pathname,
		title: document.title,
	});
}

// コメント欄のあるページでだけ埋め込みスクリプトを読む。data-auto="false" で自動描画は止め、
// こちらから init する
// 裏で描画している(Speculation Rules の prerender)間は読まず、実際に開かれてから読む
function load(target: HTMLElement, server: string) {
	const script = document.createElement("script");
	script.src = `${server}/embed.js`;
	script.dataset.auto = "false";
	script.onload = () => mount(target, server);
	document.head.appendChild(script);
}

const target = document.getElementById("yosegaki");
const server = target?.dataset.server;
if (target && server) {
	whenActivated(() => load(target, server));
}
</script>
