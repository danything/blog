---
import "@/styles/yosegaki.css";
import { commentConfig } from "@/config";
---
{commentConfig.enable && (
    <div class="flex w-full rounded-[var(--radius-large)] relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <div id="yosegaki"></div>
        </div>
    </div>
)}

<script>
import { commentConfig } from "@/config";

const { yosegaki: conf } = commentConfig;

type Instance = { destroy: () => void };

declare global {
	interface Window {
		Yosegaki?: {
			init: (opts: Record<string, unknown>) => Instance | null;
		};
	}
}

let instance: Instance | null = null;

function mount() {
	const target = document.getElementById("yosegaki");
	if (!target) return;

	if (!window.Yosegaki) {
		console.error(`[comments] yosegaki を読み込めませんでした (${conf.server}/embed.js)`);
		return;
	}

	// 2 回目以降 (swup 遷移) は既存インスタンスを捨てて作り直す。
	// 同梱 CSS は init のたびに <head> に無ければ入れ直される
	instance?.destroy();
	instance = window.Yosegaki.init({
		target,
		server: conf.server,
		lang: "ja",
		// クエリ文字列でスレッドが分かれないよう URL を明示する
		page: location.origin + location.pathname,
		title: document.title,
	});
}

// 初回だけ埋め込みスクリプトを読む。data-auto="false" で自動描画は止め、
// こちらから init する
function load() {
	if (window.Yosegaki) {
		mount();
		return;
	}
	const script = document.createElement("script");
	script.src = `${conf.server}/embed.js`;
	script.dataset.auto = "false";
	script.onload = mount;
	document.head.appendChild(script);
}

if (commentConfig.enable) {
	const setup = () => {
		window.swup.hooks.on("page:view", load);
	};

	load();

	if (window?.swup?.hooks) {
		setup();
	} else {
		document.addEventListener("swup:enable", setup);
	}
}
</script>
