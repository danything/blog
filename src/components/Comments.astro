---
import "@/styles/yosegaki.css";
import { commentConfig } from "@/config";
---
{commentConfig.enable && (
    <div class="flex w-full rounded-[var(--radius-large)] relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <div id="yosegaki"></div>
        </div>
    </div>
)}

<script>
import { commentConfig } from "@/config";

const { yosegaki: conf } = commentConfig;

declare global {
	interface Window {
		Yosegaki?: {
			init: (opts: Record<string, unknown>) => unknown;
		};
	}
}

function mount(target: HTMLElement) {
	if (!window.Yosegaki) {
		console.error(`[comments] yosegaki を読み込めませんでした (${conf.server}/embed.js)`);
		return;
	}

	window.Yosegaki.init({
		target,
		server: conf.server,
		lang: document.documentElement.lang === "en" ? "en" : "ja",
		// クエリ文字列でスレッドが分かれないよう URL を明示する
		page: location.origin + location.pathname,
		title: document.title,
	});
}

// コメント欄のあるページでだけ埋め込みスクリプトを読む。data-auto="false" で自動描画は止め、
// こちらから init する
const target = document.getElementById("yosegaki");
if (target) {
	const script = document.createElement("script");
	script.src = `${conf.server}/embed.js`;
	script.dataset.auto = "false";
	script.onload = () => mount(target);
	document.head.appendChild(script);
}
</script>
