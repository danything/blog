---
import Icon from "@components/misc/Icon.astro";
import { navBarConfig, siteConfig } from "../config";
import { BUILD_ID } from "../constants/build";
import { AUTO_MODE, DARK_MODE, LIGHT_MODE } from "../constants/constants";
import { getLinkPresets } from "../constants/link-presets";
import I18nKey from "../i18n/i18nKey";
import { i18n, langFromPath } from "../i18n/translation";
import { LinkPreset, type NavBarLink } from "../types/config";
import { getAlternates } from "../utils/content-utils";
import { localeUrl, url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;
const lang = langFromPath(Astro.url.pathname);
const LinkPresets = getLinkPresets(lang);

// 言語の切り替え先。同じページのもう一方の言語版、無ければもう一方のトップ。
// ナビゲーションバーはページ遷移の間も残るので、遷移のたびに下のスクリプトで <head> の hreflang から付け直す
const otherLang = lang === "ja" ? "en" : "ja";
const switchUrl =
	(await getAlternates(Astro.url.pathname))?.[otherLang] ??
	localeUrl("/", otherLang);

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "card-base !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between px-4"]}>
        <a href={localeUrl('/', lang)} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <Icon name="material-symbols:home-outline-rounded" class="text-[1.75rem] mb-1 mr-2" />
                {siteConfig.title}
            </div>
        </a>
        <div class="hidden md:flex">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : localeUrl(l.url, lang)} target={l.external ? "_blank" : null}
                          class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95"
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="flex">
            <Search client:only="svelte" placeholder={i18n(I18nKey.search, lang)}></Search>
            <!-- 言語を切り替えると検索の索引(Pagefind は言語ごと)も変わるので、ページを読み直す -->
            <a id="lang-switch" href={switchUrl} hreflang={otherLang} lang={otherLang} data-astro-reload
               data-other-lang={otherLang} data-fallback={localeUrl("/", otherLang)}
               aria-label={i18n(I18nKey.switchLanguage, lang)} title={i18n(I18nKey.switchLanguage, lang)}
               class="btn-plain scale-animation rounded-lg h-11 px-3 gap-1 font-bold text-sm active:scale-90">
                <Icon name="material-symbols:translate-rounded" class="text-[1.25rem]"></Icon>
                <span class="hidden sm:inline">{i18n(I18nKey.otherLanguage, lang)}</span>
            </a>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch client:only="svelte" labels={{
                [LIGHT_MODE]: i18n(I18nKey.lightMode, lang),
                [DARK_MODE]: i18n(I18nKey.darkMode, lang),
                [AUTO_MODE]: i18n(I18nKey.systemMode, lang),
            }}></LightDarkSwitch>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links} lang={lang}></NavMenuPanel>
        <DisplaySettings client:only="svelte" title={i18n(I18nKey.themeColor, lang)}></DisplaySettings>
    </div>
</div>

<script>
function switchTheme() {
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
    } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
    }
}

function loadButtonScript() {
    let switchBtn = document.getElementById("scheme-switch");
    if (switchBtn) {
        switchBtn.onclick = function () {
            switchTheme()
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function (e) {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                const opened = !settingPanel.classList.toggle("float-panel-closed");
                // キーボードで開いたとき(Enter / Space だと detail が 0)は、中のスライダーへ移す
                if (opened && e.detail === 0) {
                    document.getElementById("colorSlider")?.focus();
                }
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

loadButtonScript();

// 言語の切り替えボタンの行き先を、今のページのもう一方の言語版にする
function updateLangSwitch() {
    const link = document.getElementById("lang-switch");
    if (!(link instanceof HTMLAnchorElement)) return;
    const alt = document.querySelector<HTMLLinkElement>(
        `link[rel="alternate"][hreflang="${link.dataset.otherLang}"]`,
    );
    // hreflang は本番の絶対 URL なので、パスだけ使う(プレビューなど別のホストでも動くように)
    link.href = alt ? new URL(alt.href).pathname : (link.dataset.fallback ?? "/");
}
document.addEventListener("astro:page-load", updateLangSwitch);
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: `${url('/pagefind/pagefind.js')}?v=${BUILD_ID}`}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
