---
import Icon from "@components/misc/Icon.astro";
import { navBarConfig, siteConfig } from "../config";
import { BUILD_ID } from "../constants/build";
import { getLinkPresets } from "../constants/link-presets";
import I18nKey from "../i18n/i18nKey";
import { i18n, langFromPath } from "../i18n/translation";
import { LinkPreset, type NavBarLink } from "../types/config";
import { getAlternates } from "../utils/content-utils";
import { localeUrl, url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.astro";
import Search from "./Search.astro";
import DisplaySettings from "./widget/DisplaySettings.astro";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;
const lang = langFromPath(Astro.url.pathname);
const LinkPresets = getLinkPresets(lang);

// 言語の切り替え先。同じページのもう一方の言語版、無ければもう一方のトップ
const otherLang = lang === "ja" ? "en" : "ja";
const switchUrl =
	(await getAlternates(Astro.url.pathname))?.[otherLang] ??
	localeUrl("/", otherLang);

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<!-- data-pagefind: 検索の索引を読むスクリプトの URL(下のスクリプトが読む。開発中は検索できないので付けない) -->
<div id="navbar" class="onload-animation" data-pagefind={import.meta.env.PROD ? `${url('/pagefind/pagefind.js')}?v=${BUILD_ID}` : undefined}>
    <div class="navbar-top"></div> <!-- used for onload animation -->
    <div class:list={[className, "card-base navbar-card"]}>
        <a href={localeUrl('/', lang)} class="btn-plain scale-animation home-link">
            <div class="home-link-inner">
                <Icon name="lucide:house" class="home-icon" />
                {siteConfig.title}
            </div>
        </a>
        <div class="nav-links">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : localeUrl(l.url, lang)} target={l.external ? "_blank" : null}
                          class="btn-plain scale-animation nav-link"
                >
                    <div class="nav-link-inner">
                        {l.name}
                        {l.external && <Icon name="lucide:external-link" class="external-icon"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="nav-buttons">
            <Search lang={lang} />
            <a href={switchUrl} hreflang={otherLang} lang={otherLang}
               aria-label={i18n(I18nKey.switchLanguage, lang)} title={i18n(I18nKey.switchLanguage, lang)}
               class="btn-plain scale-animation lang-switch">
                <Icon name="lucide:languages" class="nav-icon"></Icon>
                <span class="lang-label">{i18n(I18nKey.otherLanguage, lang)}</span>
            </a>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation nav-button" id="display-settings-switch">
                        <Icon name="lucide:palette" class="nav-icon"></Icon>
                    </button>
            )}
            <LightDarkSwitch lang={lang} />
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation nav-button" id="nav-menu-switch">
                <Icon name="lucide:menu" class="nav-icon"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links} lang={lang}></NavMenuPanel>
        <DisplaySettings lang={lang} />
    </div>
</div>

<style>
    #navbar {
        z-index: 50;
    }
    /* 上から入ってくる動きのときに、カードの上にすき間が見えないように */
    .navbar-top {
        position: absolute;
        top: -2rem;
        left: 0;
        right: 0;
        height: 2rem;
        background-color: var(--card-bg);
        transition: var(--transition);
    }
    .navbar-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: var(--page-width);
        height: 4.5rem;
        margin-inline: auto;
        padding-inline: 1rem;
        overflow: visible;
        border-top-left-radius: 0;
        border-top-right-radius: 0;
    }
    .home-link {
        height: 3.25rem;
        padding-inline: 1.25rem;
        border-radius: 0.5rem;
        font-weight: 700;

        &:active {
            scale: 0.95;
        }
    }
    .home-link-inner {
        display: flex;
        align-items: center;
        color: var(--primary);
    }
    .home-icon {
        margin-right: 0.5rem;
        margin-bottom: 0.25rem;
        font-size: 1.75rem;
    }
    .nav-links {
        display: none;

        @media (width >= 48rem) {
            display: flex;
        }
    }
    .nav-link {
        height: 2.75rem;
        padding-inline: 1.25rem;
        border-radius: 0.5rem;
        font-weight: 700;

        &:active {
            scale: 0.95;
        }
    }
    .nav-link-inner {
        display: flex;
        align-items: center;
    }
    .external-icon {
        margin-left: 0.25rem;
        font-size: 0.875rem;
        color: color-mix(in oklab, var(--black) 20%, transparent);
        translate: 0 -1px;
        transition: var(--transition);

        :global(.dark) & {
            color: color-mix(in oklab, var(--white) 20%, transparent);
        }
    }
    .nav-buttons {
        display: flex;
    }
    /* 右側のアイコンのボタン */
    .nav-button {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 0.5rem;

        &:active {
            scale: 0.9;
        }
    }
    .nav-icon {
        font-size: 1.25rem;
    }
    .lang-switch {
        height: 2.75rem;
        gap: 0.25rem;
        padding-inline: 0.75rem;
        font-size: var(--text-sm);
        line-height: var(--text-sm-lh);
        font-weight: 700;
        border-radius: 0.5rem;

        &:active {
            scale: 0.9;
        }
    }
    .lang-label {
        display: none;

        @media (width >= 40rem) {
            display: inline;
        }
    }
    #nav-menu-switch {
        @media (width >= 48rem) {
            display: none;
        }
    }
</style>

<script>
document.getElementById("display-settings-switch")?.addEventListener("click", (e) => {
    const settingPanel = document.getElementById("display-setting");
    if (settingPanel) {
        const opened = !settingPanel.classList.toggle("float-panel-closed");
        // キーボードで開いたとき(Enter / Space だと detail が 0)は、中のスライダーへ移す
        if (opened && e.detail === 0) {
            document.getElementById("colorSlider")?.focus();
        }
    }
});

document.getElementById("nav-menu-switch")?.addEventListener("click", () => {
    document.getElementById("nav-menu-panel")?.classList.toggle("float-panel-closed");
});
</script>

<script>
// Pagefind(検索)を読み込み、終わると pagefindready(失敗なら pagefindloaderror)を出す(Search.astro が待つ)。
// 読み込むのは同じサイトのファイルだけで副作用は無いので、裏で描画している(prerender)間も読んでおく
async function loadPagefind(scriptUrl: string) {
    try {
        const response = await fetch(scriptUrl, { method: "HEAD" });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(/* @vite-ignore */ scriptUrl);

        await pagefind.options({
            excerptLength: 20,
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent("pagefindready"));
    } catch (error) {
        console.error("Failed to load Pagefind:", error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
        };
        document.dispatchEvent(new CustomEvent("pagefindloaderror"));
    }
}

const pagefindUrl = document.getElementById("navbar")?.dataset.pagefind;
if (pagefindUrl) loadPagefind(pagefindUrl);
</script>
