---
import Icon from "@components/misc/Icon.astro";
import {
	AUTO_MODE,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
} from "@constants/constants.ts";
import I18nKey from "@i18n/i18nKey";
import { i18n, type Lang } from "@i18n/translation";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const modes = [
	{
		mode: LIGHT_MODE,
		icon: "lucide:sun",
		label: i18n(I18nKey.lightMode, lang),
	},
	{
		mode: DARK_MODE,
		icon: "lucide:moon",
		label: i18n(I18nKey.darkMode, lang),
	},
	{
		mode: AUTO_MODE,
		icon: "lucide:contrast",
		label: i18n(I18nKey.systemMode, lang),
	},
];
// 保存されたテーマはスクリプトで反映する。ここでは既定のテーマで描いておく
---
<!-- z-50 make the panel higher than other float panels -->
<div class="relative z-50" role="group" data-light-dark-switch>
    <button aria-label="Light/Dark Mode" class="relative btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="scheme-switch">
        {modes.map(({ mode, icon }) => (
            <div class:list={["absolute", { "opacity-0": mode !== DEFAULT_THEME }]} data-mode-icon={mode}>
                <Icon name={icon} class="text-[1.25rem]" />
            </div>
        ))}
    </button>

    <div id="light-dark-panel" class="hidden lg:block absolute transition float-panel-closed top-11 -right-2 pt-5" >
        <div class="card-base float-panel p-2">
            {modes.map(({ mode, icon, label }, i) => (
                <button class:list={[
                            "flex transition whitespace-nowrap items-center !justify-start w-full btn-plain scale-animation rounded-lg h-9 px-3 font-medium active:scale-95",
                            { "mb-0.5": i < modes.length - 1, "current-theme-btn": mode === DEFAULT_THEME },
                        ]}
                        data-mode={mode}
                >
                    <Icon name={icon} class="text-[1.25rem] mr-3" />
                    {label}
                </button>
            ))}
        </div>
    </div>
</div>

<script>
import { AUTO_MODE, DARK_MODE, LIGHT_MODE } from "@constants/constants.ts";
import {
	applyThemeToDocument,
	getStoredTheme,
	setTheme,
} from "@utils/setting-utils.ts";
import type { LIGHT_DARK_MODE } from "@/types/config.ts";

const seq: LIGHT_DARK_MODE[] = [LIGHT_MODE, DARK_MODE, AUTO_MODE];

// 「システム」のときは OS の設定が変わったら追従する
window
	.matchMedia("(prefers-color-scheme: dark)")
	.addEventListener("change", () => applyThemeToDocument(getStoredTheme()));

function setup(group: HTMLElement) {
	const switchBtn = group.querySelector<HTMLButtonElement>("#scheme-switch");
	const panel = group.querySelector<HTMLElement>("#light-dark-panel");
	if (!switchBtn || !panel) return;

	let mode = getStoredTheme();

	// ボタンのアイコンとパネルの選択中の印を mode に合わせる
	const render = () => {
		for (const icon of group.querySelectorAll<HTMLElement>(
			"[data-mode-icon]",
		)) {
			icon.classList.toggle("opacity-0", icon.dataset.modeIcon !== mode);
		}
		for (const btn of panel.querySelectorAll<HTMLElement>("[data-mode]")) {
			btn.classList.toggle("current-theme-btn", btn.dataset.mode === mode);
		}
	};

	const switchScheme = (newMode: LIGHT_DARK_MODE) => {
		mode = newMode;
		setTheme(newMode);
		render();
	};

	const showPanel = () => panel.classList.remove("float-panel-closed");
	const hidePanel = () => panel.classList.add("float-panel-closed");

	switchBtn.addEventListener("click", () => {
		switchScheme(seq[(seq.indexOf(mode) + 1) % seq.length]);
	});
	switchBtn.addEventListener("mouseenter", showPanel);
	switchBtn.addEventListener("focus", showPanel);
	for (const btn of panel.querySelectorAll<HTMLElement>("[data-mode]")) {
		btn.addEventListener("click", () =>
			switchScheme(btn.dataset.mode as LIGHT_DARK_MODE),
		);
	}

	group.addEventListener("mouseleave", hidePanel);
	// キーボードでも使えるよう、ボタンにフォーカスが来たら開き、外へ出たら閉じる
	// (閉じたパネルは visibility: hidden なので、開いていないと Tab で中に入れない)
	group.addEventListener("focusout", (e) => {
		if (e.relatedTarget instanceof Node && group.contains(e.relatedTarget)) {
			return;
		}
		if (!group.matches(":hover")) hidePanel();
	});
	group.addEventListener("keydown", (e) => {
		if (e.key !== "Escape") return;
		// ボタンへ戻すと focus で開くので、戻してから閉じる
		switchBtn.focus();
		hidePanel();
	});

	render();
}

for (const group of document.querySelectorAll<HTMLElement>(
	"[data-light-dark-switch]",
)) {
	setup(group);
}
</script>
