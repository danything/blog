---
import I18nKey from "../i18n/i18nKey";
import { i18n, langFromPath } from "../i18n/translation";
import type { PostForList } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

interface Props {
	sortedPosts: PostForList[];
}

// 一覧はビルド時に HTML で出す(検索エンジンや JavaScript の無い環境でも読める)。
// ?tag= / ?category= / ?uncategorized=true での絞り込みだけ下のスクリプトで行う
const { sortedPosts } = Astro.props;

const groups = new Map<number, PostForList[]>();
for (const post of sortedPosts) {
	const year = post.data.published.getFullYear();
	groups.set(year, [...(groups.get(year) ?? []), post]);
}
const years = [...groups.keys()].sort((a, b) => b - a);

const formatDate = (date: Date) =>
	`${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
const lang = langFromPath(Astro.url.pathname);
---

<div class="card-base" id="archive-panel">
    {years.map((year) => {
        const posts = groups.get(year) ?? [];
        return (
        <div data-archive-group>
            <div class="year-row">
                <div class="col-date year">
                    {year}
                </div>
                <div class="col-line">
                    <div class="year-circle"></div>
                </div>
                <div class="year-count">
                    <span data-archive-count>{posts.length}</span> {i18n(posts.length === 1 ? I18nKey.postCount : I18nKey.postsCount, lang)}
                </div>
            </div>

            {posts.map((post) => (
                <a
                        href={getPostUrlBySlug(post.slug, lang)}
                        aria-label={post.data.title}
                        class="btn-plain post"
                        data-tags={JSON.stringify(post.data.tags)}
                        data-category={post.data.category ?? ""}
                >
                    <div class="post-row">
                        <!-- date -->
                        <div class="col-date date">
                            {formatDate(post.data.published)}
                        </div>

                        <!-- dot and line -->
                        <div class="col-line dash-line">
                            <div class="dot"></div>
                        </div>

                        <!-- post title -->
                        <div class="title">
                            {post.data.title}
                        </div>

                        <!-- tag list -->
                        <div class="tags">
                            {post.data.tags.map((t) => `#${t}`).join(" ")}
                        </div>
                    </div>
                </a>
            ))}
        </div>
        );
    })}
</div>

<style>
    #archive-panel {
        padding: 1.5rem 2rem;
    }
    /* 左から日付・線・タイトル・タグの列 */
    .col-date,
    .col-line {
        width: 15%;

        @media (width >= 48rem) {
            width: 10%;
        }
    }
    .year-row {
        display: flex;
        align-items: center;
        width: 100%;
        height: 3.75rem;
    }
    .year {
        font-size: var(--text-2xl);
        line-height: var(--text-2xl-lh);
        font-weight: 700;
        text-align: right;
        color: var(--text-75);
        transition: var(--transition);
    }
    .year-circle {
        z-index: 50;
        width: 0.75rem;
        height: 0.75rem;
        margin-inline: auto;
        border-radius: calc(infinity * 1px);
        background-image: none;
        outline: 3px solid var(--primary);
        outline-offset: -2px;
    }
    .year-count {
        width: 70%;
        text-align: left;
        color: var(--text-50);
        transition: var(--transition);

        @media (width >= 48rem) {
            width: 80%;
        }
    }

    .post {
        display: block;
        width: 100%;
        height: 2.5rem;
        border-radius: 0.5rem;
    }
    .post-row {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        height: 100%;
    }
    .date {
        font-size: var(--text-sm);
        line-height: var(--text-sm-lh);
        text-align: right;
        color: var(--text-50);
        transition: var(--transition);
    }
    /* 記事をつなぐ縦の点線 */
    .dash-line {
        position: relative;
        display: flex;
        align-items: center;
        height: 100%;

        &::before {
            content: "";
            position: absolute;
            left: calc(50% - 1px);
            width: 10%;
            height: 100%;
            border-left: 2px dashed var(--line-color);
            pointer-events: none;
            transform: translateY(-50%);
            transition: all 0.3s;
        }
    }
    /* 記事の点。マウスを乗せると縦に伸びる */
    .dot {
        z-index: 50;
        width: 0.25rem;
        height: 0.25rem;
        margin-inline: auto;
        border-radius: 0.25rem;
        background-color: oklch(0.5 0.05 var(--hue));
        outline: 4px solid var(--card-bg);
        transition: all 0.15s var(--ease);
    }
    .title {
        width: 70%;
        padding-right: 2rem;
        overflow: hidden;
        text-align: left;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 700;
        color: var(--text-75);
        transition: all 0.15s var(--ease);

        @media (width >= 48rem) {
            width: 65%;
            max-width: 65%;
        }
    }
    .tags {
        display: none;
        overflow: hidden;
        text-align: left;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: var(--text-sm);
        line-height: var(--text-sm-lh);
        color: var(--text-30);
        transition: var(--transition);

        @media (width >= 48rem) {
            display: block;
            width: 15%;
        }
    }
    /* マウスを乗せると、背景が付き(.btn-plain)、点が伸びて、タイトルがテーマの色になる(ライト・ダークとも)。
     * 日付とタグの色は変えない */
    @media (hover: hover) {
        .post:hover {
            .dot {
                height: 1.25rem;
                background-color: var(--primary);
                outline-color: var(--btn-plain-bg-hover);
            }
            .title {
                translate: 0.25rem;
                color: var(--primary);
            }
        }
    }
    .post:active .dot {
        outline-color: var(--btn-plain-bg-active);
    }
</style>

<script>
// URL の条件に合わない記事を隠し、年ごとの件数を数え直す
function filterArchive() {
	const panel = document.getElementById("archive-panel");
	if (!panel) return;
	const params = new URLSearchParams(location.search);
	const tags = params.getAll("tag");
	const categories = params.getAll("category");
	const uncategorized = params.has("uncategorized");

	for (const group of panel.querySelectorAll<HTMLElement>("[data-archive-group]")) {
		let visible = 0;
		for (const post of group.querySelectorAll<HTMLElement>("a[data-tags]")) {
			const postTags: string[] = JSON.parse(post.dataset.tags ?? "[]");
			const category = post.dataset.category ?? "";
			const show =
				(tags.length === 0 || postTags.some((t) => tags.includes(t))) &&
				(categories.length === 0 || categories.includes(category)) &&
				(!uncategorized || category === "");
			// hidden 属性は !important の display: none になる(styles/reset.css)ので、リンクの display: block に勝つ
			post.hidden = !show;
			if (show) visible++;
		}
		group.hidden = visible === 0;
		const count = group.querySelector("[data-archive-count]");
		if (count) count.textContent = String(visible);
	}
}

filterArchive();
</script>
