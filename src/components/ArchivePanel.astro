---
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import type { PostForList } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

interface Props {
	sortedPosts: PostForList[];
}

// 一覧はビルド時に HTML で出す(検索エンジンや JavaScript の無い環境でも読める)。
// ?tag= / ?category= / ?uncategorized=true での絞り込みだけ下のスクリプトで行う
const { sortedPosts } = Astro.props;

const groups = new Map<number, PostForList[]>();
for (const post of sortedPosts) {
	const year = post.data.published.getFullYear();
	groups.set(year, [...(groups.get(year) ?? []), post]);
}
const years = [...groups.keys()].sort((a, b) => b - a);

const formatDate = (date: Date) =>
	`${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
---

<div class="card-base px-8 py-6" id="archive-panel">
    {years.map((year) => {
        const posts = groups.get(year) ?? [];
        return (
        <div data-archive-group>
            <div class="flex flex-row w-full items-center h-[3.75rem]">
                <div class="w-[15%] md:w-[10%] transition text-2xl font-bold text-right text-75">
                    {year}
                </div>
                <div class="w-[15%] md:w-[10%]">
                    <div
                            class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto
                  -outline-offset-[2px] z-50 outline-3"
                    ></div>
                </div>
                <div class="w-[70%] md:w-[80%] transition text-left text-50">
                    <span data-archive-count>{posts.length}</span> {i18n(posts.length === 1 ? I18nKey.postCount : I18nKey.postsCount)}
                </div>
            </div>

            {posts.map((post) => (
                <a
                        href={getPostUrlBySlug(post.slug)}
                        aria-label={post.data.title}
                        class="group btn-plain !block h-10 w-full rounded-lg hover:text-[initial]"
                        data-tags={JSON.stringify(post.data.tags)}
                        data-category={post.data.category ?? ""}
                >
                    <div class="flex flex-row justify-start items-center h-full">
                        <!-- date -->
                        <div class="w-[15%] md:w-[10%] transition text-sm text-right text-50">
                            {formatDate(post.data.published)}
                        </div>

                        <!-- dot and line -->
                        <div class="w-[15%] md:w-[10%] relative dash-line h-full flex items-center">
                            <div
                                    class="transition-all mx-auto w-1 h-1 rounded-sm group-hover:h-5
                       bg-[oklch(0.5_0.05_var(--hue))] group-hover:bg-[var(--primary)]
                       outline outline-4 z-50
                       outline-[var(--card-bg)]
                       group-hover:outline-[var(--btn-plain-bg-hover)]
                       group-active:outline-[var(--btn-plain-bg-active)]"
                            ></div>
                        </div>

                        <!-- post title -->
                        <div
                                class="w-[70%] md:max-w-[65%] md:w-[65%] text-left font-bold
                     group-hover:translate-x-1 transition-all group-hover:text-[var(--primary)]
                     text-75 pr-8 whitespace-nowrap text-ellipsis overflow-hidden"
                        >
                            {post.data.title}
                        </div>

                        <!-- tag list -->
                        <div
                                class="hidden md:block md:w-[15%] text-left text-sm transition
                     whitespace-nowrap text-ellipsis overflow-hidden text-30"
                        >
                            {post.data.tags.map((t) => `#${t}`).join(" ")}
                        </div>
                    </div>
                </a>
            ))}
        </div>
        );
    })}
</div>

<script>
// URL の条件に合わない記事を隠し、年ごとの件数を数え直す
function filterArchive() {
	const panel = document.getElementById("archive-panel");
	if (!panel) return;
	const params = new URLSearchParams(location.search);
	const tags = params.getAll("tag");
	const categories = params.getAll("category");
	const uncategorized = params.has("uncategorized");

	for (const group of panel.querySelectorAll<HTMLElement>("[data-archive-group]")) {
		let visible = 0;
		for (const post of group.querySelectorAll<HTMLElement>("a[data-tags]")) {
			const postTags: string[] = JSON.parse(post.dataset.tags ?? "[]");
			const category = post.dataset.category ?? "";
			const show =
				(tags.length === 0 || postTags.some((t) => tags.includes(t))) &&
				(categories.length === 0 || categories.includes(category)) &&
				(!uncategorized || category === "");
			// リンクには !block が付いているので、hidden 属性ではなく同じく !important の hidden! で隠す
			post.classList.toggle("hidden!", !show);
			if (show) visible++;
		}
		group.classList.toggle("hidden!", visible === 0);
		const count = group.querySelector("[data-archive-count]");
		if (count) count.textContent = String(visible);
	}
}

document.addEventListener("astro:page-load", filterArchive);
</script>
