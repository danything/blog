---
import Icon from "@components/misc/Icon.astro";
import type { Page } from "astro";
import I18nKey from "../../i18n/i18nKey";
import { i18n, langFromPath } from "../../i18n/translation";
import { localeUrl } from "../../utils/url-utils";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

// 呼び出し元の <style> が効くよう、残りの属性(data-astro-cid-*)も外側の要素に付ける
const { page, class: className, ...rest } = Astro.props;

const HIDDEN = -1;

const ADJ_DIST = 2;
const VISIBLE = ADJ_DIST * 2 + 1;

// for test
let count = 1;
let l = page.currentPage;
let r = page.currentPage;
while (0 < l - 1 && r + 1 <= page.lastPage && count + 2 <= VISIBLE) {
	count += 2;
	l--;
	r++;
}
while (0 < l - 1 && count < VISIBLE) {
	count++;
	l--;
}
while (r + 1 <= page.lastPage && count < VISIBLE) {
	count++;
	r++;
}

let pages: number[] = [];
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push(HIDDEN);
for (let i = l; i <= r; i++) pages.push(i);
if (r < page.lastPage - 2) pages.push(HIDDEN);
if (r === page.lastPage - 2) pages.push(page.lastPage - 1);
if (r < page.lastPage) pages.push(page.lastPage);

const lang = langFromPath(Astro.url.pathname);
const getPageUrl = (p: number) => localeUrl(p === 1 ? "/" : `/${p}/`, lang);
---

<div class:list={[className, "pagination"]} {...rest}>
    <a href={page.url.prev ?? undefined} aria-label={page.url.prev ? i18n(I18nKey.previousPage, lang) : null}
       class:list={["btn-card arrow", {"disabled": page.url.prev == undefined}]}
    >
        <Icon name="lucide:chevron-left" class="arrow-icon"></Icon>
    </a>
    <div class="pages">
        {pages.map((p) => {
            if (p == HIDDEN)
                return <Icon name="lucide:ellipsis" class="ellipsis"/>;
            if (p == page.currentPage)
                return <div class="current">
                    {p}
                </div>
            return <a href={getPageUrl(p)} aria-label={i18n(I18nKey.pageNumber, lang).replace("{n}", String(p))} class="btn-card page"
            >{p}</a>
        })}
    </div>
    <a href={page.url.next ?? undefined} aria-label={page.url.next ? i18n(I18nKey.nextPage, lang) : null}
       class:list={["btn-card arrow", {"disabled": page.url.next == undefined}]}
    >
        <Icon name="lucide:chevron-right" class="arrow-icon"></Icon>
    </a>
</div>

<style>
    .pagination {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
    }
    .arrow,
    .page,
    .current {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 0.5rem;
    }
    .arrow,
    .page {
        overflow: hidden;
    }
    .arrow:not(.disabled) {
        color: var(--primary);
    }
    .arrow-icon {
        font-size: 1.75rem;
    }
    .pages {
        display: flex;
        align-items: center;
        border-radius: 0.5rem;
        background-color: var(--card-bg);
        font-weight: 700;
        color: var(--label-color);
    }
    .ellipsis {
        margin-inline: 0.25rem;
    }
    .page:active {
        scale: 0.85;
    }
    .current {
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--primary);
        font-weight: 700;
        color: white;

        :global(.dark) & {
            color: color-mix(in oklab, var(--black) 70%, transparent);
        }
    }
</style>
