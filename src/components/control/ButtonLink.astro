---
interface Props {
	badge?: string;
	/** 数の後ろに読み上げだけで足す言葉(「件の投稿」など)。画面には出さない */
	badgeSuffix?: string;
	url?: string;
}
const { badge, badgeSuffix, url } = Astro.props;
---
{/* 名前は見えている文字(と読み上げ用の単位)から付ける。aria-label で別の言い方にすると、
    音声操作で見えている文字を言っても押せなくなる */}
<a href={url}>
    <button>
        <div class="row">
            <div class="label">
                <slot></slot>
            </div>
            { badge !== undefined && badge !== null && badge !== '' &&
                <div class="badge text-sm">
                    { badge }{ badgeSuffix && <span class="sr-only"> {badgeSuffix}</span> }
                </div>
            }
        </div>
    </button>
</a>

<style>
    /* 一覧のボタン(カテゴリ)。マウスを乗せると少し右へずれる */
    button {
        width: 100%;
        height: 2.5rem;
        padding-left: 0.5rem;
        border-radius: 0.5rem;
        background-image: none;
        color: var(--label-color);
        transition: all 0.15s var(--ease);
        @media (hover: hover) {
            &:hover {
                padding-left: 0.75rem;
                background-color: var(--btn-plain-bg-hover);
                color: var(--primary);
            }
        }
        &:active {
            background-color: var(--btn-plain-bg-active);
        }
    }
    .row {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-right: 0.5rem;
    }
    .label {
        overflow: hidden;
        text-align: left;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
    /* 記事の数 */
    .badge {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 2rem;
        height: 1.75rem;
        margin-left: 1rem;
        padding-inline: 0.5rem;
        border-radius: 0.5rem;
        background-color: var(--btn-regular-bg);
        font-weight: 700;
        color: var(--btn-content);
        transition: var(--transition);

        :global(.dark) & {
            background-color: var(--primary);
            color: var(--deep-text);
        }
    }
</style>
