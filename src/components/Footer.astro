---

import { langFromPath, siteText } from "../i18n/translation";
import { localeUrl, url } from "../utils/url-utils";

const lang = langFromPath(Astro.url.pathname);

const currentYear = new Date().getFullYear();
---

<div class="separator"></div>
<div class="footer-box">
    <div class="footer-text text-sm">
        &copy; <span id="copyright-year">{currentYear}</span> {siteText(lang).profileName}. All Rights Reserved. /
        <a class="link" target="_blank" href={localeUrl('/rss.xml', lang)}>RSS</a> /
        <a class="link" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a><br>
        Powered by
        <a class="link" target="_blank" href="https://astro.build">Astro</a> &
        <a class="link" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a>
    </div>
</div>

<style>
    .separator {
        margin: 2.5rem 8rem;
        border-top-width: 1px;
        border-style: dashed;
        border-color: var(--dashed-line);
        transition: var(--transition);
    }
    .footer-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin-bottom: 3rem;
        padding-inline: 1.5rem;
        border-style: dashed;
        border-color: oklch(85% 0.01 var(--hue));
        border-radius: 1rem;
        transition: var(--transition);

        :global(.dark) & {
            border-color: color-mix(in oklab, var(--white) 15%, transparent);
        }
    }
    .footer-text {
        text-align: center;
        color: var(--text-50);
        transition: var(--transition);
    }
    .link {
        font-weight: 500;
        color: var(--primary);
    }
</style>
