---
import type { Page } from "astro";
import { profileConfig, siteConfig } from "../../config";
import { type Lang, siteText } from "../../i18n/translation";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import type { PostEntry } from "../../utils/content-utils";
import { localeUrl } from "../../utils/url-utils";
import Pagination from "../control/Pagination.astro";
import PostPage from "../PostPage.astro";

// 記事一覧のページ(日本語版 pages/[...page].astro、英語版 pages/en/[...page].astro の中身)
interface Props {
	page: Page<PostEntry>;
	lang: Lang;
}

const { page, lang } = Astro.props;
const text = siteText(lang);

const len = page.data.length;

// トップページ(1 ページ目)だけに、サイトと著者の構造化データを出す
const person = {
	"@type": "Person",
	name: text.profileName,
	url: Astro.site,
	image: new URL(profileConfig.avatar ?? "", Astro.site).href,
	sameAs: profileConfig.links.map((link) => link.url),
};
const jsonLd =
	page.currentPage === 1
		? {
				"@context": "https://schema.org",
				"@type": "WebSite",
				name: siteConfig.title,
				url: new URL(localeUrl("/", lang), Astro.site).href,
				description: text.description,
				inLanguage: lang,
				author: person,
				publisher: person,
			}
		: undefined;
---

<MainGridLayout>
    {jsonLd && <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>
