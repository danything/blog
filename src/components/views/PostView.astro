---
import { render } from "astro:content";
import path from "node:path";
import Comments from "@components/Comments.astro";
import Icon from "@components/misc/Icon.astro";
import KofiPostEnd from "@components/misc/KofiPostEnd.astro";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import Share from "@components/misc/Share.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n, type Lang, siteText } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import type { PostEntry } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { licenseConfig } from "@/config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";
import PostMetadata from "../PostMeta.astro";

// 記事のページ(日本語版 pages/posts/、英語版 pages/en/posts/ の中身)
interface Props {
	entry: PostEntry;
	lang: Lang;
}

const { entry, lang } = Astro.props;
const isTranslation = entry.collection === "postsEn";
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: siteText(lang).profileName,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang ? entry.data.lang.replace("_", "-") : lang,
	// TODO include cover image here
};
---
<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} ogImage={isTranslation ? `/og/en/${entry.id}.png` : `/og/${entry.id}.png`} headings={headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="post-card">
        <div id="post-container" class="card-base">
            <!-- word count and reading time -->
            <div class="stats onload-animation">
                <div class="stat">
                    <div class="stat-icon">
                        <Icon name="lucide:text"></Icon>
                    </div>
                    <div class="stat-text">{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount, lang)}</div>
                </div>
                <div class="stat">
                    <div class="stat-icon">
                        <Icon name="lucide:clock"></Icon>
                    </div>
                    <div class="stat-text">
                        {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount, lang)}
                    </div>
                </div>
            </div>

            <!-- title -->
            <div class="title-wrapper onload-animation">
                <div data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title" class="title">
                    {entry.data.title}
                </div>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="meta"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                ></PostMetadata>
                {!entry.data.image && <div class="meta-divider"></div>}
            </div>

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join(isTranslation ? "content/posts-en/" : "content/posts/", getDir(entry.id))} class="cover onload-animation"/>
            }


            {isTranslation && (
                <div class="translated-notice onload-animation">
                    {i18n(I18nKey.translatedNotice, lang)}
                    <a href={getPostUrlBySlug(entry.id, "ja")} hreflang="ja" class="link">{i18n(I18nKey.readOriginal, lang)}</a>
                </div>
            )}

            <Markdown class="section onload-animation">
                <Content />
            </Markdown>

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.id} pubDate={entry.data.published} class="section license onload-animation"></License>}

            <Share title={entry.data.title} class="section onload-animation"></Share>

            <KofiPostEnd class="section onload-animation"></KofiPostEnd>

        </div>
    </div>

    <!-- 前後の記事 -->
    <div class="neighbors">
        <a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug, lang) : undefined}
           class:list={["neighbor", {"empty": !entry.data.nextSlug}]}>
            {entry.data.nextSlug && <div class="btn-card neighbor-button">
                <Icon name="lucide:chevron-left" class="neighbor-icon" />
                <div class="neighbor-title">
                    {entry.data.nextTitle}
                </div>
            </div>}
        </a>

        <a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug, lang) : undefined}
           class:list={["neighbor", {"empty": !entry.data.prevSlug}]}>
            {entry.data.prevSlug && <div class="btn-card neighbor-button next">
                <div class="neighbor-title">
                    {entry.data.prevTitle}
                </div>
                <Icon name="lucide:chevron-right" class="neighbor-icon" />
            </div>}
        </a>
    </div>

    <Comments />

</MainGridLayout>

<style>
    .post-card {
        position: relative;
        display: flex;
        width: 100%;
        margin-bottom: 1rem;
        overflow: hidden;
        border-radius: var(--radius-large);
    }
    #post-container {
        position: relative;
        z-index: 10;
        width: 100%;
        padding: 1.5rem 1.5rem 1rem;

        @media (width >= 48rem) {
            padding-inline: 2.25rem;
        }
    }
    .stats {
        display: flex;
        gap: 1.25rem;
        margin-bottom: 0.75rem;
        color: var(--text-30);
        transition: var(--transition);
    }
    .stat {
        display: flex;
        align-items: center;
    }
    .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1.5rem;
        margin-right: 0.5rem;
        border-radius: 0.375rem;
        background-color: color-mix(in oklab, var(--black) 5%, transparent);
        color: color-mix(in oklab, var(--black) 50%, transparent);
        transition: var(--transition);

        :global(.dark) & {
            background-color: color-mix(in oklab, var(--white) 10%, transparent);
            color: color-mix(in oklab, var(--white) 50%, transparent);
        }
    }
    .stat-text {
        font-size: var(--text-sm);
        line-height: var(--text-sm-lh);
    }
    .title-wrapper {
        position: relative;
    }
    /* タイトルの左の縦線は ::before で描く(広い画面だけ幅を持たせる) */
    .title {
        display: block;
        width: 100%;
        margin-bottom: 0.75rem;
        font-size: var(--text-3xl);
        line-height: var(--text-3xl-lh);
        font-weight: 700;
        color: color-mix(in oklab, var(--black) 90%, transparent);
        transition: var(--transition);

        :global(.dark) & {
            color: color-mix(in oklab, var(--white) 90%, transparent);
        }
        &::before {
            content: "";
            position: absolute;
            top: 0.75rem;
            left: -1.125rem;
            height: 1.25rem;
            border-radius: 0.375rem;
            background-color: var(--primary);
        }
        @media (width >= 48rem) {
            font-size: 2.25rem;
            line-height: 2.75rem;

            &::before {
                width: 0.25rem;
            }
        }
    }
    .meta {
        margin-bottom: 1.25rem;
    }
    .meta-divider {
        margin-bottom: 1.25rem;
        border-bottom-width: 1px;
        border-style: dashed;
        border-color: var(--line-divider);
    }
    .cover {
        margin-bottom: 2rem;
        border-radius: 0.75rem;
    }
    .translated-notice {
        margin-bottom: 1.5rem;
        padding: 0.75rem 1.25rem;
        border-radius: 0.75rem;
        background-color: var(--license-block-bg);
        font-size: var(--text-sm);
        line-height: var(--text-sm-lh);
        color: var(--text-75);
        transition: var(--transition);

        .link {
            font-weight: 500;
            color: var(--primary);
        }
    }
    .section {
        margin-bottom: 1.5rem;
    }
    .license {
        border-radius: 0.75rem;
    }

    .neighbors {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1rem;
        width: 100%;
        margin-bottom: 1rem;
        overflow: hidden;

        @media (width >= 48rem) {
            flex-direction: row;
        }
    }
    .neighbor {
        width: 100%;
        overflow: hidden;
        font-weight: 700;

        &:active {
            scale: 0.95;
        }
        &.empty {
            pointer-events: none;
        }
    }
    .neighbor-button {
        justify-content: flex-start;
        gap: 1rem;
        width: 100%;
        max-width: 100%;
        height: 3.75rem;
        padding-inline: 1rem;
        border-radius: 1rem;

        &.next {
            justify-content: flex-end;
        }
    }
    .neighbor-icon {
        font-size: 2rem;
        color: var(--primary);
    }
    .neighbor-title {
        max-width: calc(100% - 3rem);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--text-75);
        transition: var(--transition);
    }
</style>
