---
import I18nKey from "@i18n/i18nKey";
import { i18n, type Lang } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { localeUrl } from "@utils/url-utils";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
---
<MainGridLayout title="404" description="404 Not Found">
    <div class="page">
        <div class="card-base page-card">
            <!-- 透かしの飾りなので文字にはせず ::before で出す(読み上げとコントラストの検査から外す) -->
            <div aria-hidden="true" class="watermark"></div>
            <div class="message">{i18n(I18nKey.notFound, lang)}</div>
            <a href={localeUrl("/", lang)} class="btn-regular home-link">{i18n(I18nKey.backToHome, lang)}</a>
        </div>
    </div>
</MainGridLayout>

<style>
    .page {
        position: relative;
        display: flex;
        width: 100%;
        min-height: 8rem;
        overflow: hidden;
        border-radius: var(--radius-large);
    }
    .page-card {
        position: relative;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        width: 100%;
        min-height: 20rem;
        padding: 1.5rem 2.25rem;
    }
    .watermark {
        font-size: 8rem;
        line-height: 1;
        font-weight: 700;
        color: color-mix(in oklab, var(--black) 10%, transparent);
        transition: var(--transition);

        :global(.dark) & {
            color: color-mix(in oklab, var(--white) 10%, transparent);
        }
        &::before {
            content: "404";
        }
    }
    .message {
        color: var(--text-75);
        transition: var(--transition);
    }
    .home-link {
        margin-top: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
    }
</style>
