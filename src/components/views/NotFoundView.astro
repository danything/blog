---
import I18nKey from "@i18n/i18nKey";
import { i18n, type Lang } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { localeUrl } from "@utils/url-utils";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
---
<MainGridLayout title="404" description="404 Not Found">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full flex flex-col items-center justify-center min-h-[20rem] gap-4">
            <!-- 透かしの飾りなので文字にはせず ::before で出す(読み上げとコントラストの検査から外す) -->
            <div aria-hidden="true" class="text-9xl font-bold text-black/10 dark:text-white/10 transition before:content-['404']"></div>
            <div class="text-black/75 dark:text-white/75 transition">{i18n(I18nKey.notFound, lang)}</div>
            <a href={localeUrl("/", lang)} class="btn-regular rounded-lg px-4 py-2 mt-2">{i18n(I18nKey.backToHome, lang)}</a>
        </div>
    </div>
</MainGridLayout>
