---
import { render } from "astro:content";
import Icon from "@components/misc/Icon.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n, langFromPath } from "../i18n/translation";
import {
	type PostEntry,
	postImageBase,
	readingStats,
} from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	entry: PostEntry;
	class?: string;
	style?: string;
}
const { entry, class: className, style } = Astro.props;
const { title, published, updated, tags, category, image, description } =
	entry.data;
const lang = langFromPath(Astro.url.pathname);
const url = getPostUrlBySlug(entry.id, lang);
const hasCover = image !== "";

const coverWidth = "28%";

const { remarkPluginFrontmatter } = await render(entry);
const stats = readingStats(remarkPluginFrontmatter, lang);
---
<div class:list={["card-base post-card", className]} style={style}>
    <div class:list={["content", {"has-cover": hasCover}]}>
        <a href={url} class="title text-3xl">
            {title}
            <Icon class="title-arrow-mobile" name="lucide:chevron-right" ></Icon>
            <Icon class="title-arrow" name="lucide:chevron-right"></Icon>
        </a>

        <!-- metadata -->
        <PostMetadata published={published} updated={updated} tags={tags} category={category} hideTagsForMobile={true} hideUpdateDate={true} class="meta"></PostMetadata>

        <!-- description -->
        <div class:list={["description", {"excerpt": !description}]}>
            { description || remarkPluginFrontmatter.excerpt }
        </div>

        <!-- word count and read time  -->
        <div class="stats text-sm">
            <div>{stats.words}</div>
            <div>|</div>
            <div>{stats.minutes}</div>
        </div>

    </div>

    {hasCover && <a href={url} aria-label={title} class="cover">
        <div class="cover-overlay"></div>
        <div class="cover-icon-wrapper">
            <Icon name="lucide:chevron-right" class="cover-icon">
            </Icon>
        </div>
        <ImageWrapper src={image} basePath={postImageBase(entry)} alt={i18n(I18nKey.coverImage, lang)}
                  class="cover-image">
        </ImageWrapper>
    </a>}

    {!hasCover &&
        <a href={url} aria-label={title} class="btn-regular enter">
            <Icon name="lucide:chevron-right" class="enter-icon">
            </Icon>
        </a>
    }
</div>
<div class="divider"></div>

<style define:vars={{coverWidth}}>
    /* 狭い画面ではカバー画像を上に、広い画面では右に置く */
    .post-card {
        position: relative;
        display: flex;
        flex-direction: column-reverse;
        width: 100%;
        overflow: hidden;
        border-radius: var(--radius-large);

        @media (width >= 48rem) {
            flex-direction: column;
        }
    }
    .content {
        position: relative;
        width: 100%;
        padding: 1.5rem;

        @media (width >= 48rem) {
            width: calc(100% - 52px - 12px);
            padding: 1.75rem 0.5rem 1.5rem 2.25rem;

            &.has-cover {
                width: calc(100% - var(--coverWidth) - 12px);
            }
        }
    }
    /* タイトルの左の縦線は ::before で描く(広い画面だけ) */
    .title {
        display: block;
        width: 100%;
        margin-bottom: 0.75rem;
        font-weight: 700;
        color: var(--text-90);
        transition: var(--transition);

        &::before {
            content: "";
            position: absolute;
            top: 35px;
            left: 18px;
            display: none;
            width: 0.25rem;
            height: 1.25rem;
            border-radius: 0.375rem;
            background-color: var(--primary);

            @media (width >= 48rem) {
                display: block;
            }
        }
        @media (hover: hover) {
            &:hover {
                color: var(--primary);
            }
        }
        &:active {
            color: var(--title-active);
        }
    }
    .title-arrow-mobile,
    .title-arrow {
        position: absolute;
        font-size: 2rem;
        color: var(--primary);
    }
    .title-arrow-mobile {
        display: inline;
        translate: 0 0.125rem;

        @media (width >= 48rem) {
            display: none;
        }
    }
    /* 広い画面では、マウスを乗せたときだけ出る */
    .title-arrow {
        display: none;
        opacity: 0;
        translate: -0.25rem 0.125rem;
        transition: var(--transition);

        @media (width >= 48rem) {
            display: inline;
        }
        @media (hover: hover) {
            .title:hover & {
                opacity: 1;
                translate: 0 0.125rem;
            }
        }
    }
    .meta {
        margin-bottom: 1rem;
    }
    .description {
        margin-bottom: 0.875rem;
        padding-right: 1rem;
        color: var(--text-75);
        transition: var(--transition);

        /* 説明が無く本文の抜き出しを出すときは、行数を絞る */
        &.excerpt {
            display: -webkit-box;
            overflow: hidden;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;

            @media (width >= 48rem) {
                -webkit-line-clamp: 1;
            }
        }
    }
    .stats {
        display: flex;
        gap: 1rem;
        color: var(--text-30);
        transition: var(--transition);
    }

    .cover {
        position: relative;
        max-height: 20vh;
        margin: 1rem 1rem -0.5rem;
        overflow: hidden;
        border-radius: 0.75rem;

        &:active {
            scale: 0.95;
        }
        @media (width >= 48rem) {
            position: absolute;
            top: 0.75rem;
            right: 0.75rem;
            bottom: 0.75rem;
            width: var(--coverWidth);
            max-height: none;
            margin: 0;
        }
    }
    .cover-overlay,
    .cover-icon-wrapper {
        position: absolute;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }
    .cover-overlay {
        z-index: 10;
        transition: var(--transition);
    }
    .cover-icon-wrapper {
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .cover-icon {
        font-size: 3rem;
        line-height: 1;
        color: white;
        opacity: 0;
        scale: 0.5;
        transition: var(--transition);
    }
    @media (hover: hover) {
        .cover:hover {
            .cover-overlay {
                background-color: color-mix(in oklab, var(--black) 30%, transparent);
            }
            .cover-icon {
                opacity: 1;
                scale: 1;
            }
        }
    }
    .cover:active .cover-overlay {
        background-color: color-mix(in oklab, var(--black) 50%, transparent);
    }
    .cover-image {
        width: 100%;
        height: 100%;
    }

    /* カバー画像の無い記事は、右に入るためのボタンを置く(広い画面だけ) */
    .enter {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        bottom: 0.75rem;
        display: none;
        width: 3.25rem;
        border-radius: 0.75rem;
        background-color: var(--enter-btn-bg);

        @media (hover: hover) {
            &:hover {
                background-color: var(--enter-btn-bg-hover);
            }
        }
        &:active {
            scale: 0.95;
            background-color: var(--enter-btn-bg-active);
        }
        @media (width >= 48rem) {
            display: flex;
        }
    }
    .enter-icon {
        margin-inline: auto;
        font-size: 2.25rem;
        line-height: calc(2.5 / 2.25);
        color: var(--primary);
        transition: var(--transition);
    }

    /* 狭い画面では記事の間に点線を引く */
    .divider {
        margin-inline: 1.5rem;
        border-top-width: 1px;
        border-style: dashed;
        border-color: var(--dashed-line);
        transition: var(--transition);

        &:last-child {
            border-top-width: 0;
        }
        @media (width >= 48rem) {
            display: none;
        }
    }
</style>
