---
import Icon from "@components/misc/Icon.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n, type Lang } from "@i18n/translation";

interface Props {
	lang: Lang;
}

const placeholder = i18n(I18nKey.search, Astro.props.lang);
---
<div data-search class="contents">
<!-- search bar for desktop view -->
<div id="search-bar" class="hidden lg:flex transition-all items-center h-11 mr-2 rounded-lg
      bg-black/[0.04] hover:bg-black/[0.06] focus-within:bg-black/[0.06]
      dark:bg-white/5 dark:hover:bg-white/10 dark:focus-within:bg-white/10
">
    <Icon name="lucide:search" class="absolute text-[1.25rem] pointer-events-none ml-3 transition my-auto text-black/30 dark:text-white/30" />
    <input placeholder={placeholder} data-search-input="desktop"
           class="transition-all pl-10 text-sm bg-transparent outline-0
         h-full w-40 active:w-60 focus:w-60 text-50"
    >
</div>

<!-- toggle btn for phone/tablet view -->
<button aria-label="Search Panel" id="search-switch"
        class="btn-plain scale-animation lg:!hidden rounded-lg w-11 h-11 active:scale-90">
    <Icon name="lucide:search" class="text-[1.25rem]" />
</button>

<!-- search panel -->
<div id="search-panel" class="float-panel float-panel-closed search-panel absolute md:w-[30rem]
top-20 left-4 md:left-[unset] right-4 shadow-2xl rounded-2xl p-2">

    <!-- search bar inside panel for phone/tablet -->
    <div id="search-bar-inside" class="flex relative lg:hidden transition-all items-center h-11 rounded-xl
      bg-black/[0.04] hover:bg-black/[0.06] focus-within:bg-black/[0.06]
      dark:bg-white/5 dark:hover:bg-white/10 dark:focus-within:bg-white/10
  ">
        <Icon name="lucide:search" class="absolute text-[1.25rem] pointer-events-none ml-3 transition my-auto text-black/30 dark:text-white/30" />
        <input placeholder={placeholder} data-search-input="mobile"
               class="pl-10 absolute inset-0 text-sm bg-transparent outline-0
               focus:w-60 text-50"
        >
    </div>

    <!-- search results(下のテンプレートを複製して、この後ろに並べる) -->
</div>

<template data-search-result>
    <a class="transition first-of-type:mt-2 lg:first-of-type:mt-0 group block
       rounded-xl text-lg px-3 py-2 hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)]">
        <div class="transition text-90 inline-flex font-bold group-hover:text-[var(--primary)]">
            <span data-title></span><Icon name="lucide:chevron-right" class="transition text-[0.75rem] translate-x-1 my-auto text-[var(--primary)]" />
        </div>
        <div class="transition text-sm text-50" data-excerpt></div>
    </a>
</template>
</div>

<style>
  input:focus {
    outline: 0;
  }
  .search-panel {
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }
</style>

<script>
import type { SearchResult } from "@/global";

const fakeResult: SearchResult[] = [
	{
		url: import.meta.env.BASE_URL,
		meta: {
			title: "This Is a Fake Search Result",
		},
		excerpt:
			"Because the search cannot work in the <mark>dev</mark> environment.",
	},
	{
		url: import.meta.env.BASE_URL,
		meta: {
			title: "If You Want to Test the Search",
		},
		excerpt: "Try running <mark>npm build && npm preview</mark> instead.",
	},
];

// Pagefind は Navbar.astro のスクリプトが読み込み、終わると pagefindready(失敗なら pagefindloaderror)を出す
let pagefindDone = import.meta.env.DEV;
const pagefindWaiters: (() => void)[] = [];
function onPagefindDone() {
	if (pagefindDone) return;
	pagefindDone = true;
	for (const f of pagefindWaiters.splice(0)) f();
}
if (!pagefindDone) {
	document.addEventListener("pagefindready", onPagefindDone);
	document.addEventListener("pagefindloaderror", () => {
		console.warn(
			"Pagefind load error event received. Search functionality will be limited.",
		);
		onPagefindDone();
	});
	// Fallback in case events are not caught or pagefind is already loaded by the time this script runs
	setTimeout(onPagefindDone, 2000);
}

function setup(root: HTMLElement) {
	const panel = root.querySelector<HTMLElement>("#search-panel");
	const template = root.querySelector<HTMLTemplateElement>(
		"template[data-search-result]",
	);
	const desktop = root.querySelector<HTMLInputElement>(
		'[data-search-input="desktop"]',
	);
	const mobile = root.querySelector<HTMLInputElement>(
		'[data-search-input="mobile"]',
	);
	if (!panel || !template || !desktop || !mobile) return;

	let initialized = false;
	// 遅れて返ってきた古い検索の結果で、新しい結果を上書きしないように
	let latest = 0;

	const setPanelVisibility = (show: boolean, isDesktop: boolean) => {
		if (!isDesktop) return;
		panel.classList.toggle("float-panel-closed", !show);
	};

	const render = (result: SearchResult[]) => {
		for (const a of panel.querySelectorAll(":scope > a")) a.remove();
		for (const item of result) {
			const node = template.content.cloneNode(true) as DocumentFragment;
			const a = node.querySelector("a");
			const title = node.querySelector("[data-title]");
			const excerpt = node.querySelector("[data-excerpt]");
			if (!a || !title || !excerpt) continue;
			a.href = item.url;
			title.replaceWith(item.meta.title);
			// 抜粋は Pagefind が一致した語を <mark> で囲んだ HTML
			excerpt.innerHTML = item.excerpt;
			panel.append(node);
		}
	};

	const search = async (keyword: string, isDesktop: boolean) => {
		const id = ++latest;
		if (!keyword) {
			setPanelVisibility(false, isDesktop);
			render([]);
			return;
		}
		if (!initialized) return;

		let result: SearchResult[] = [];
		try {
			if (import.meta.env.PROD && window.pagefind) {
				const response = await window.pagefind.search(keyword);
				result = await Promise.all(
					response.results.map((item) => item.data()),
				);
			} else if (import.meta.env.DEV) {
				result = fakeResult;
			} else {
				console.error("Pagefind is not available in production environment.");
			}
		} catch (error) {
			console.error("Search error:", error);
			result = [];
		}
		if (id !== latest) return;
		render(result);
		setPanelVisibility(result.length > 0, isDesktop);
	};

	// 空にしたときは検索し直さない(結果はそのまま残る)。入力欄にフォーカスし直すと閉じる。
	// ただし途中の検索の結果は、遅れて返ってきても捨てる
	const onInput = (input: HTMLInputElement, isDesktop: boolean) => () => {
		if (input.value) search(input.value, isDesktop);
		else latest++;
	};
	desktop.addEventListener("input", onInput(desktop, true));
	desktop.addEventListener("focus", () => search(desktop.value, true));
	mobile.addEventListener("input", onInput(mobile, false));

	root.querySelector("#search-switch")?.addEventListener("click", () => {
		panel.classList.toggle("float-panel-closed");
	});

	const init = () => {
		initialized = true;
		if (desktop.value) search(desktop.value, true);
		if (mobile.value) search(mobile.value, false);
	};
	if (pagefindDone) init();
	else pagefindWaiters.push(init);
}

for (const root of document.querySelectorAll<HTMLElement>("[data-search]")) {
	setup(root);
}
</script>
