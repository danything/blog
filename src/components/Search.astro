---
import Icon from "@components/misc/Icon.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n, type Lang } from "@i18n/translation";
import { url } from "@utils/url-utils";
import { BUILD_ID } from "../constants/build";

interface Props {
	lang: Lang;
}

const placeholder = i18n(I18nKey.search, Astro.props.lang);
// 検索の索引を読むスクリプトの URL(下のスクリプトが読む)。開発サーバーには索引が無いので付けない
const pagefind = import.meta.env.PROD
	? `${url("/pagefind/pagefind.js")}?v=${BUILD_ID}`
	: undefined;
// 検索できないとき(開発サーバーや、索引を読み込めなかったとき)に出す文言
const unavailable = import.meta.env.DEV
	? "開発サーバーでは検索できません(bun run build のあと bun run preview で試せます)"
	: i18n(I18nKey.searchUnavailable, Astro.props.lang);
---
<div data-search data-pagefind={pagefind} class="search">
<!-- search bar for desktop view -->
<div id="search-bar" class="search-bar">
    <Icon name="lucide:search" class="search-icon" />
    <input placeholder={placeholder} data-search-input="desktop" class="search-input">
</div>

<!-- toggle btn for phone/tablet view -->
<button aria-label="Search Panel" id="search-switch" class="btn-plain scale-animation">
    <Icon name="lucide:search" class="switch-icon" />
</button>

<!-- search panel -->
<div id="search-panel" class="float-panel float-panel-closed">

    <!-- search bar inside panel for phone/tablet -->
    <div id="search-bar-inside" class="search-bar">
        <Icon name="lucide:search" class="search-icon" />
        <input placeholder={placeholder} data-search-input="mobile" class="search-input">
    </div>

    <div data-search-message class="message" hidden>{unavailable}</div>

    <!-- search results(下のテンプレートを複製して、この後ろに並べる) -->
</div>

<template data-search-result>
    <a class="result">
        <div class="result-title">
            <span data-title></span><Icon name="lucide:chevron-right" class="result-chevron" />
        </div>
        <div class="result-excerpt" data-excerpt></div>
    </a>
</template>
</div>

<style>
  .search {
    display: contents;
  }
  /* 検索の入力欄。デスクトップではナビゲーションバーに、狭い画面ではパネルの中に出す */
  .search-bar {
    display: flex;
    align-items: center;
    height: 2.75rem;
    background-color: color-mix(in oklab, var(--black) 4%, transparent);
    transition: all 0.15s var(--ease);

    @media (hover: hover) {
      &:hover {
        background-color: color-mix(in oklab, var(--black) 6%, transparent);
      }
    }
    &:focus-within {
      background-color: color-mix(in oklab, var(--black) 6%, transparent);
    }
    :global(.dark) & {
      background-color: color-mix(in oklab, var(--white) 5%, transparent);

      @media (hover: hover) {
        &:hover {
          background-color: color-mix(in oklab, var(--white) 10%, transparent);
        }
      }
      &:focus-within {
        background-color: color-mix(in oklab, var(--white) 10%, transparent);
      }
    }
  }
  #search-bar {
    display: none;
    margin-right: 0.5rem;
    border-radius: 0.5rem;

    @media (width >= 64rem) {
      display: flex;
    }
  }
  #search-bar-inside {
    position: relative;
    border-radius: 0.75rem;

    @media (width >= 64rem) {
      display: none;
    }
  }
  .search-icon {
    position: absolute;
    margin-block: auto;
    margin-left: 0.75rem;
    font-size: 1.25rem;
    color: color-mix(in oklab, var(--black) 30%, transparent);
    pointer-events: none;
    transition: var(--transition);

    :global(.dark) & {
      color: color-mix(in oklab, var(--white) 30%, transparent);
    }
  }
  .search-input {
    padding-left: 2.5rem;
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-50);
    background-color: transparent;
    outline: 0 solid;

    &:focus {
      outline: 0;
      width: 15rem;
    }
  }
  #search-bar .search-input {
    width: 10rem;
    height: 100%;
    transition: all 0.15s var(--ease);

    &:active,
    &:focus {
      width: 15rem;
    }
  }
  #search-bar-inside .search-input {
    position: absolute;
    inset: 0;
  }
  #search-switch {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.5rem;

    &:active {
      scale: 0.9;
    }
    @media (width >= 64rem) {
      display: none;
    }
  }
  .switch-icon {
    font-size: 1.25rem;
  }

  #search-panel {
    position: absolute;
    top: 5rem;
    left: 1rem;
    right: 1rem;
    max-height: calc(100vh - 100px);
    padding: 0.5rem;
    overflow-y: auto;
    border-radius: 1rem;
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);

    :global(.dark) & {
      box-shadow: none;
    }
    @media (width >= 48rem) {
      left: unset;
      width: 30rem;
    }
  }

  .message {
    padding: 0.5rem 0.75rem;
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-50);
  }
  .result {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.75rem;
    font-size: var(--text-lg);
    line-height: var(--text-lg-lh);
    transition: var(--transition);

    &:first-of-type {
      margin-top: 0.5rem;

      @media (width >= 64rem) {
        margin-top: 0;
      }
    }
    @media (hover: hover) {
      &:hover {
        background-color: var(--btn-plain-bg-hover);
      }
      &:hover .result-title {
        color: var(--primary);
      }
    }
    &:active {
      background-color: var(--btn-plain-bg-active);
    }
  }
  .result-title {
    display: inline-flex;
    font-weight: 700;
    color: var(--text-90);
    transition: var(--transition);
  }
  .result-chevron {
    margin-block: auto;
    font-size: 0.75rem;
    color: var(--primary);
    translate: 0.25rem;
    transition: var(--transition);
  }
  .result-excerpt {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-50);
    transition: var(--transition);

    /* 一致した語(Pagefind が <mark> で囲む) */
    :global(mark) {
      background-color: transparent;
      color: var(--primary);
    }
  }
</style>

<script>
// 検索(Pagefind)。索引を読むスクリプトはビルドで dist/pagefind/ に作られるので、開発サーバーには無い
// (data-pagefind を付けない)。読み込むのは同じサイトのファイルだけで副作用は無いので、
// 裏で描画している(prerender)間も、ページを開いたらすぐ読み始める
type SearchResult = { url: string; meta: { title: string }; excerpt: string };
type Pagefind = {
	options: (options: { excerptLength: number }) => Promise<void>;
	search: (query: string) => Promise<{
		results: { data: () => Promise<SearchResult> }[];
	}>;
};

async function loadPagefind(url: string | undefined): Promise<Pagefind | undefined> {
	if (!url) return undefined;
	try {
		const pagefind: Pagefind = await import(/* @vite-ignore */ url);
		await pagefind.options({ excerptLength: 20 });
		return pagefind;
	} catch (error) {
		console.error("Failed to load Pagefind:", error);
		return undefined;
	}
}

function setup(root: HTMLElement) {
	const panel = root.querySelector<HTMLElement>("#search-panel");
	const template = root.querySelector<HTMLTemplateElement>(
		"template[data-search-result]",
	);
	const message = root.querySelector<HTMLElement>("[data-search-message]");
	const desktop = root.querySelector<HTMLInputElement>(
		'[data-search-input="desktop"]',
	);
	const mobile = root.querySelector<HTMLInputElement>(
		'[data-search-input="mobile"]',
	);
	if (!panel || !template || !message || !desktop || !mobile) return;

	const pagefind = loadPagefind(root.dataset.pagefind);
	// 遅れて返ってきた古い検索の結果で、新しい結果を上書きしないように
	let latest = 0;

	const setPanelVisibility = (show: boolean, isDesktop: boolean) => {
		if (!isDesktop) return;
		panel.classList.toggle("float-panel-closed", !show);
	};

	const render = (result: SearchResult[]) => {
		for (const a of panel.querySelectorAll(":scope > a")) a.remove();
		for (const item of result) {
			const node = template.content.cloneNode(true) as DocumentFragment;
			const a = node.querySelector("a");
			const title = node.querySelector("[data-title]");
			const excerpt = node.querySelector("[data-excerpt]");
			if (!a || !title || !excerpt) continue;
			a.href = item.url;
			title.replaceWith(item.meta.title);
			// 抜粋は Pagefind が一致した語を <mark> で囲んだ HTML
			excerpt.innerHTML = item.excerpt;
			panel.append(node);
		}
	};

	const search = async (keyword: string, isDesktop: boolean) => {
		const id = ++latest;
		if (!keyword) {
			setPanelVisibility(false, isDesktop);
			render([]);
			message.hidden = true;
			return;
		}
		// 索引を読み込む前に打った語は、読み込めてから検索する
		const pf = await pagefind;
		let result: SearchResult[] = [];
		let failed = !pf;
		try {
			if (pf) {
				const response = await pf.search(keyword);
				result = await Promise.all(response.results.map((item) => item.data()));
			}
		} catch (error) {
			console.error("Search error:", error);
			failed = true;
		}
		if (id !== latest) return;
		render(result);
		// 開発サーバーや、索引を読み込めなかったときは、検索できないことを出す
		message.hidden = !failed;
		setPanelVisibility(failed || result.length > 0, isDesktop);
	};

	// 空にしたときは検索し直さない(結果はそのまま残る)。入力欄にフォーカスし直すと閉じる。
	// ただし途中の検索の結果は、遅れて返ってきても捨てる
	const onInput = (input: HTMLInputElement, isDesktop: boolean) => () => {
		if (input.value) search(input.value, isDesktop);
		else latest++;
	};
	desktop.addEventListener("input", onInput(desktop, true));
	desktop.addEventListener("focus", () => search(desktop.value, true));
	mobile.addEventListener("input", onInput(mobile, false));

	root.querySelector("#search-switch")?.addEventListener("click", () => {
		panel.classList.toggle("float-panel-closed");
	});
}

for (const root of document.querySelectorAll<HTMLElement>("[data-search]")) {
	setup(root);
}
</script>
