---
import Icon from "@components/misc/Icon.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n, langFromPath } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";

interface Props {
	class: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
}
// 呼び出し元の <style> が効くよう、残りの属性(data-astro-cid-*)も外側の要素に付ける
const {
	published,
	updated,
	tags,
	category,
	hideTagsForMobile = false,
	hideUpdateDate = false,
	class: className,
	...rest
} = Astro.props;
const lang = langFromPath(Astro.url.pathname);
---

<div class:list={["post-meta", className]} {...rest}>
    {/* publish date */}
    <div class="item">
        <div class="meta-icon">
            <Icon name="lucide:calendar" class="icon text-xl"></Icon>
        </div>
        <span class="text text-sm">{formatDateToYYYYMMDD(published)}</span>
    </div>

    {/* update date */}
    {!hideUpdateDate && updated && updated.getTime() !== published.getTime() && (
        <div class="item">
            <div class="meta-icon">
                <Icon name="lucide:calendar-sync" class="icon text-xl"></Icon>
            </div>
            <span class="text text-sm">{formatDateToYYYYMMDD(updated)}</span>
        </div>
    )}

    {/* categories */}
    <div class="item">
        <div class="meta-icon">
            <Icon name="lucide:book" class="icon text-xl"></Icon>
        </div>
        <div class="values">
            <a href={getCategoryUrl(category, lang)} aria-label={i18n(I18nKey.viewCategory, lang).replace("{name}", category || i18n(I18nKey.uncategorized, lang))}
               class="link-lg text value-link text-sm">
                {category || i18n(I18nKey.uncategorized, lang)}
            </a>
        </div>
    </div>

    {/* tags */}
    <div class:list={["item", {"hide-on-mobile": hideTagsForMobile}]}>
        <div class="meta-icon">
            <Icon name="lucide:hash" class="icon text-xl"></Icon>
        </div>
        <div class="values">
            {(tags && tags.length > 0) && tags.map((tag, i) => (
                <div class:list={["separator text-sm", {"first": i == 0}]}>/</div>
                <a href={getTagUrl(tag, lang)} aria-label={i18n(I18nKey.viewTag, lang).replace("{name}", tag.trim())}
                   class="link-lg text value-link text-sm">
                    {tag.trim()}
                </a>
            ))}
            {!(tags && tags.length > 0) && <div class="text text-sm">{i18n(I18nKey.noTags, lang)}</div>}
        </div>
    </div>
</div>

<style>
    .post-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1rem;
        color: var(--meta-color);
    }
    .item {
        display: flex;
        align-items: center;

        &.hide-on-mobile {
            display: none;

            @media (width >= 48rem) {
                display: flex;
            }
        }
    }
    .meta-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        margin-right: 0.5rem;
        border-radius: 0.375rem;
        background-color: var(--btn-regular-bg);
        color: var(--btn-content);
        transition: var(--transition);
    }
    .icon {
    }
    .text {
        font-weight: 500;
        color: var(--text-50);
        transition: var(--transition);
    }
    .values {
        display: flex;
        align-items: center;
    }
    .value-link {
        white-space: nowrap;

        @media (hover: hover) {
            &:hover {
                color: var(--primary);
            }
        }
    }
    .separator {
        margin-inline: 0.375rem;
        color: var(--meta-divider);

        &.first {
            display: none;
        }
    }
</style>
