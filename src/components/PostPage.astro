---
import { langFromPath } from "@i18n/translation";
import type { PostEntry } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;
const lang = langFromPath(Astro.url.pathname);

let delay = 0;
const interval = 50;
---
<div class="post-list">
    {page.data.map((entry: PostEntry) => (
        <PostCard
                entry={entry}
                title={entry.data.title}
                tags={entry.data.tags}
                category={entry.data.category}
                published={entry.data.published}
                updated={entry.data.updated}
                url={getPostUrlBySlug(entry.id, lang)}
                image={entry.data.image}
                description={entry.data.description}
                draft={entry.data.draft}
                class:list="onload-animation"
                style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
        ></PostCard>
    ))}
</div>

<style>
    /* 狭い画面では 1 枚のカードに記事を並べ、広い画面では記事ごとのカードにする */
    .post-list {
        display: flex;
        flex-direction: column;
        margin-bottom: 1rem;
        padding-block: 0.25rem;
        border-radius: var(--radius-large);
        background-color: var(--card-bg);
        transition: var(--transition);

        @media (width >= 48rem) {
            gap: 1rem;
            padding-block: 0;
            background-color: transparent;
        }
    }
</style>
