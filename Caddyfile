{
	# root ではない uid で読み取り専用のファイルシステムでも動くように、管理 API と
	# 設定の自動保存 (/config/caddy/autosave.json) を止める。設定は Caddyfile だけで変えない
	admin off
	persist_config off

	# TLS は前段の Cilium Gateway が終端するため、転送元ヘッダを信頼する
	servers {
		trusted_proxies static private_ranges
	}
}

# 特権ポートを避けて 8080 で待つ (Service が 80 → 8080 に転送する)
:8080 {
	root * /srv
	# 前段の Cloudflare はオリジンに Accept-Encoding: br, gzip しか送らない。br はビルドで書き出したものを
	# 返すので (下の file_server)、ここで圧縮するのは事前に圧縮していないものと gzip だけを受け付けるとき
	encode gzip

	# --- 旧 Next.js 版 URL からの 301 ---
	redir /feed.xml /rss.xml permanent
	# ご挨拶記事はサイト構成の紹介記事として書き直した
	redir /posts/hello/ /posts/renewal/ permanent
	redir /posts/hello /posts/renewal/ permanent
	redir /projects /about/ permanent
	redir /projects/ /about/ permanent
	redir /tags /archive/ permanent
	redir /tags/ /archive/ permanent

	# 記事一覧はトップページ。旧 /blog と旧ページネーションはそちらへ寄せる
	redir /blog / permanent
	redir /blog/ / permanent

	@blogPage path_regexp blogPage ^/blog/page/([0-9]+)/?$
	redir @blogPage /{re.blogPage.1}/ permanent

	@blogPost path_regexp blogPost ^/blog/(.+?)/?$
	redir @blogPost /posts/{re.blogPost.1}/ permanent

	@tag path_regexp tag ^/tags/(.+?)/?$
	redir @tag /archive/?tag={re.tag.1} permanent

	# --- セキュリティヘッダ ---
	# CSP はインラインスクリプトや Cloudflare の解析、コメント欄 (yk.doany.io)、Turnstile を
	# 使うので全体には掛けず、フレーム埋め込みの禁止 (frame-ancestors) だけにする
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# --- キャッシュ ---
	# ファイル名にハッシュが付くものだけ長期キャッシュ。Pagefind は索引の断片だけがハッシュ付きで、
	# pagefind.js や wasm.*.pagefind・pagefind-entry.json は名前が変わらないまま中身が変わる
	# (ここを長期キャッシュにしていたため、Cloudflare に古い pagefind.js が残り検索が壊れた)
	@immutable path /_astro/* /pagefind/fragment/* /pagefind/index/* /pagefind/filter/* /pagefind/*.pf_meta
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@static path /static/*
	header @static Cache-Control "public, max-age=604800"

	# HTML と、名前の変わらない Pagefind のファイルは都度検証させる
	@html not path /_astro/* /pagefind/fragment/* /pagefind/index/* /pagefind/filter/* /pagefind/*.pf_meta /static/*
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# --- 削除した記事 ---
	# 意図的に消したので 404 ではなく 410 Gone を返し、検索エンジンにも
	# 恒久的な削除として伝える。本文は下の handle_errors が返す 404 ページ (英語版 /en/posts/... は英語の 404)
	@gone path_regexp gone ^/(?:en/)?posts/(wpdevenv|hhvmlaravel|wpgit|ec-ajax|paypalmeetup|doodcron|zabbixifttt|mstdn|bbdhdeploy|dockerzabbix|kadouhyou|worklog-from-logs|ubuntulxdnet|op25b)/?$
	error @gone 410

	# ビルドで dist/ に書き出した .br (scripts/precompress.ts) をそのまま返す。
	# 無いもの (画像や Pagefind の索引など) や br を受け付けないときは元のファイルを返し、上の encode が必要なら gzip で圧縮する
	file_server {
		precompressed br
	}
	# 圧縮したファイルそのもの (/index.html.br など) は URL としては見せない
	@precompressedFile path *.br
	error @precompressedFile 404

	# 404 と、削除した記事の 410。英語版 (/en/ 以下) は英語の 404 ページを返す。
	# 状態コードはエラーのもの (404・410) がそのまま使われる
	handle_errors {
		# エラーのページはサイトの route を通らないので、ここでも gzip だけを受け付けるときに圧縮する
		encode gzip
		handle /en/* {
			rewrite * /en/404/index.html
			file_server {
				precompressed br
			}
		}
		handle {
			rewrite * /404.html
			file_server {
				precompressed br
			}
		}
	}
}
